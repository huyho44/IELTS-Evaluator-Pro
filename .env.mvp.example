# Copy to .env.mvp. Use URL-safe random secrets; do not commit .env.mvp.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes
FRONTEND_BIND=127.0.0.1
SITE_DOMAIN=ielts.your-domain.example
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GRADING_PROVIDER_URL=
GRADING_PROVIDER_KEY=
DEMO_GRADING_PROVIDER=
DEMO_GRADING_MODEL=
DEMO_PASSWORD=IeltsDemo123!
# Public frontend URL used in password-reset links, e.g. https://ielts.your-domain.example
APP_BASE_URL=http://localhost:8080
# Password-reset email over SMTP; Gmail needs a team account App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
