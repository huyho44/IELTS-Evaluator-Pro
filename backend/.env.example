# Copy this file to .env and replace all placeholder secrets.
DATABASE_URL=postgresql://root:rootpassword@localhost:5433/ielts_db?schema=public
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes-before-running
PORT=3000
# false for an API process when running a separate worker.
GRADING_WORKER_ENABLED=true

# Direct OpenAI Responses API. Set a model that is available to your API project.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative: your own assessment gateway, returning the documented JSON contract.
GRADING_PROVIDER_URL=
GRADING_PROVIDER_KEY=

# Optional published AI config for the Writing demo seed: OPENAI or JSON_HTTP.
# When blank the demo supports teacher assessment without fabricating AI results.
DEMO_GRADING_PROVIDER=
DEMO_GRADING_MODEL=

# Optional disposable local integration database; its name must end in _test.
CORE_TEST_DATABASE_URL=
