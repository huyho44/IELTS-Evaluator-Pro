/// Thông báo cho một người; link điều hướng không cấp quyền truy cập.
model Notification {
  id                  String    @id @default(uuid()) @db.Uuid
  recipientId         String    @map("recipient_id") @db.Uuid
  notificationType    String    @map("notification_type") @db.VarChar(60)
  title               String    @db.VarChar(240)
  body                String    @db.Text
  navigationPath      String?   @map("navigation_path") @db.Text
  contextSnapshotJson Json?     @map("context_snapshot_json") @db.JsonB
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt              DateTime? @map("read_at") @db.Timestamptz(3)

  recipient User @relation("Notification_recipientId", fields: [recipientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notification_recipient_id")

  @@index([recipientId], map: "ix_notification_recipient_id")
  @@index([recipientId, readAt, createdAt], map: "ix_notification_recipient_id_read_at_created_at")
  @@map("NOTIFICATION")
}

/// Đúng một target có FK: course, learning item hoặc post.
/// SQL CHECK: (CASE WHEN course_id IS NULL THEN 0 ELSE 1 END + CASE WHEN learning_item_id IS NULL THEN 0 ELSE 1 END + CASE WHEN post_id IS NULL THEN 0 ELSE 1 END) = 1
model ModerationReport {
  id             String           @id @default(uuid()) @db.Uuid
  reporterId     String           @map("reporter_id") @db.Uuid
  resolverId     String?          @map("resolver_id") @db.Uuid
  courseId       String?          @map("course_id") @db.Uuid
  learningItemId String?          @map("learning_item_id") @db.Uuid
  postId         String?          @map("post_id") @db.Uuid
  reason         String           @db.Text
  status         ModerationStatus @default(PENDING)
  resolution     String?          @db.Text
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz(3)

  reporter     User            @relation("ModerationReport_reporterId", fields: [reporterId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_moderation_report_reporter_id")
  resolver     User?           @relation("ModerationReport_resolverId", fields: [resolverId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_moderation_report_resolver_id")
  course       Course?         @relation("ModerationReport_courseId", fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_moderation_report_course_id")
  learningItem LearningItem?   @relation("ModerationReport_learningItemId", fields: [learningItemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_moderation_report_learning_item_id")
  post         DiscussionPost? @relation("ModerationReport_postId", fields: [postId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_moderation_report_post_id")

  @@index([reporterId], map: "ix_moderation_report_reporter_id")
  @@index([resolverId], map: "ix_moderation_report_resolver_id")
  @@index([courseId], map: "ix_moderation_report_course_id")
  @@index([learningItemId], map: "ix_moderation_report_learning_item_id")
  @@index([postId], map: "ix_moderation_report_post_id")
  @@map("MODERATION_REPORT")
}

/// Sự kiện hạ tầng bền vững. Aggregate locator là dữ liệu routing lịch sử, không giả làm FK nghiệp vụ.
model OutboxEvent {
  id               String       @id @default(uuid()) @db.Uuid
  eventType        String       @map("event_type") @db.VarChar(80)
  aggregateType    String       @map("aggregate_type") @db.VarChar(80)
  aggregateId      String       @map("aggregate_id") @db.Text
  aggregateVersion Int?         @map("aggregate_version")
  payloadJson      Json         @map("payload_json") @db.JsonB
  status           OutboxStatus @default(PENDING)
  attempts         Int          @default(0)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  dispatchedAt     DateTime?    @map("dispatched_at") @db.Timestamptz(3)

  @@index([status, createdAt], map: "ix_outbox_event_status_created_at")
  @@map("OUTBOX_EVENT")
}

/// Append-only ở ứng dụng. Entity locator là snapshot audit, không bắt cascade theo đối tượng bị xóa.
model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityKey  String   @map("entity_key") @db.Text
  beforeJson Json?    @map("before_json") @db.JsonB
  afterJson  Json?    @map("after_json") @db.JsonB
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  actor User? @relation("AuditEvent_actorId", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_audit_event_actor_id")

  @@index([actorId], map: "ix_audit_event_actor_id")
  @@map("AUDIT_EVENT")
}

