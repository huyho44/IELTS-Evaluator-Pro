/// Thảo luận theo khóa hoặc learning item cùng khóa.
model DiscussionThread {
  id            String   @id @default(uuid()) @db.Uuid
  courseId      String   @map("course_id") @db.Uuid
  contextItemId String?  @map("context_item_id") @db.Uuid
  creatorId     String   @map("creator_id") @db.Uuid
  title         String   @db.VarChar(240)
  status        String   @default("OPEN") @db.VarChar(24)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  course          Course           @relation("DiscussionThread_courseId", fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_discussion_thread_course_id")
  contextItem     LearningItem?    @relation("DiscussionThread_contextItemId", fields: [contextItemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_discussion_thread_context_item_id")
  creator         User             @relation("DiscussionThread_creatorId", fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_discussion_thread_creator_id")
  discussionPosts DiscussionPost[] @relation("DiscussionPost_threadId")

  @@index([courseId], map: "ix_discussion_thread_course_id")
  @@index([contextItemId], map: "ix_discussion_thread_context_item_id")
  @@index([creatorId], map: "ix_discussion_thread_creator_id")
  @@map("DISCUSSION_THREAD")
}

/// Reply phải cùng thread, không tự trỏ/chu trình.
model DiscussionPost {
  id           String    @id @default(uuid()) @db.Uuid
  threadId     String    @map("thread_id") @db.Uuid
  authorId     String    @map("author_id") @db.Uuid
  parentPostId String?   @map("parent_post_id") @db.Uuid
  body         String    @db.Text
  status       String    @default("VISIBLE") @db.VarChar(24)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt     DateTime? @map("edited_at") @db.Timestamptz(3)

  thread            DiscussionThread   @relation("DiscussionPost_threadId", fields: [threadId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_discussion_post_thread_id")
  author            User               @relation("DiscussionPost_authorId", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_discussion_post_author_id")
  parentPost        DiscussionPost?    @relation("DiscussionPost_parentPostId", fields: [parentPostId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_discussion_post_parent_post_id")
  discussionPosts   DiscussionPost[]   @relation("DiscussionPost_parentPostId")
  moderationReports ModerationReport[] @relation("ModerationReport_postId")

  @@index([threadId], map: "ix_discussion_post_thread_id")
  @@index([authorId], map: "ix_discussion_post_author_id")
