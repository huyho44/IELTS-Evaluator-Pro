generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
/// Represents the lifecycle state of a user account.
enum AccountStatus {
  ACTIVE    // Account is fully operational
  SUSPENDED // Account has been temporarily disabled
  CLOSED    // Account has been permanently closed

  @@map("account_status")
}

/// Represents the approval state of a submitted application or request.
enum ApprovalStatus {
  PENDING  // Awaiting review
  APPROVED // Accepted by a reviewer
  REJECTED // Declined by a reviewer

  @@map("approval_status")
}

/// Controls the visibility / release state of content (courses, items, etc.).
enum PublicationStatus {
  DRAFT     // Only visible to authors/instructors
  PUBLISHED // Publicly visible and available
  HIDDEN    // Temporarily concealed from learners
  ARCHIVED  // Retired content, read-only

  @@map("publication_status")
}

/// Discriminator that distinguishes the two concrete subtypes of LearningItem.
enum LearningItemKind {
  LESSON   // A reading/video lesson with materials
  PRACTICE // A practice activity with questions

  @@map("learning_item_kind")
}

/// The IELTS skill area targeted by an activity or question.
enum SkillArea {
  READING   // Reading comprehension
  LISTENING // Audio-based comprehension
  WRITING   // Written production
  SPEAKING  // Spoken production

  @@map("skill_area")
}

/// How a learner submits their answer for an activity.
enum ResponseMode {
  OBJECTIVE // Multiple-choice / short-answer (auto-gradable)
  WRITING   // Free-form written text
  SPEAKING  // Audio recording

  @@map("response_mode")
}

/// Whether an assignment is high-stakes (graded) or low-stakes (practice).
enum AssignmentMode {
  PRACTICE // No formal grade; learner can explore freely
  GRADED   // Counts toward official assessment

  @@map("assignment_mode")
}

/// Tracks the progress of a single learner attempt through an assignment.
enum AttemptStatus {
  IN_PROGRESS // Learner has started but not yet submitted
  SUBMITTED   // Learner has submitted; awaiting grading
  FINISHED    // Grading is complete and results are available
  CANCELLED   // Attempt was voided before completion

  @@map("attempt_status")
}

/// Lifecycle of an asynchronous background job (e.g. AI grading run).
enum RunStatus {
  QUEUED    // Waiting to be picked up by a worker
  RUNNING   // Currently being processed
  COMPLETED // Finished successfully
  FAILED    // Terminated with an unrecoverable error

  @@map("run_status")
}

/// Outcome of a single call to an external AI provider.
enum ProviderAttemptStatus {
  SUCCESS    // Provider returned a valid, parseable response
  REFUSED    // Provider rejected the request (e.g. content policy)
  INCOMPLETE // Response was cut off or truncated
  INVALID    // Response could not be parsed into the expected schema
  ERROR      // Network or infrastructure-level failure

  @@map("provider_attempt_status")
}

/// Identifies the source that produced an AssessmentResult.
enum ResultKind {
  AI         // Produced by the AI grading pipeline
  TEACHER    // Produced by a human teacher review
  ANSWER_KEY // Produced by automatic answer-key matching

  @@map("result_kind")
}

/// The score scale used when reporting an overall result.
enum ScoreScale {
  BAND // IELTS band score (0-9, one decimal place)
  RAW  // Raw marks (integer or decimal count)

  @@map("score_scale")
}

/// Quality gate applied to an AI-generated result before it is surfaced.
enum QualityStatus {
  PASSED  // Result passed automated quality checks
  FLAGGED // Result requires human review before release

  @@map("quality_status")
}

/// State machine for an instructor review case.
enum ReviewStatus {
  PENDING   // Case is open and unassigned
  CLAIMED   // An instructor has taken ownership
  CONFIRMED // The instructor has published a decision
  CANCELLED // Case was closed without a decision

  @@map("review_status")
}

/// State machine for a learner appeal against an accepted assessment.
enum AppealStatus {
  PENDING   // Submitted but not yet reviewed
  IN_REVIEW // Being actively reviewed
  RESOLVED  // Outcome has been communicated to the learner
  REJECTED  // Appeal was dismissed

  @@map("appeal_status")
}

/// How well a skill was demonstrated within a single assessment result.
enum ObservationOutcome {
  MET          // Skill was clearly demonstrated
  PARTIAL      // Skill was partially demonstrated
  NOT_MET      // Evidence shows the skill is not yet mastered
  NOT_OBSERVED // Insufficient evidence to make a judgment

  @@map("observation_outcome")
}

/// Aggregate observation status across all evidence for a skill in a profile.
enum ObservationStatus {
  UNKNOWN      // No evidence has been collected yet
  INSUFFICIENT // Some evidence exists but too little to be conclusive
  OBSERVED     // Enough evidence for a reliable strength estimate

  @@map("observation_status")
}

/// The type of payload stored in a LessonMaterial record.
enum MaterialKind {
  TEXT // Inline rich text content
  URL  // An external hyperlink
  FILE // An uploaded file asset

  @@map("material_kind")
}

/// The interaction type used in a Question.
enum QuestionType {
  SINGLE_CHOICE   // Exactly one correct option
  MULTIPLE_CHOICE // One or more correct options
  SHORT_ANSWER    // Free-text response matched against an answer key

  @@map("question_type")
}

/// State machine for content moderation reports.
enum ModerationStatus {
  PENDING   // Report filed, awaiting moderator action
  RESOLVED  // Moderator took action on the reported content
  DISMISSED // Report was reviewed and found to be invalid

  @@map("moderation_status")
}

/// State machine for the transactional outbox pattern.
enum OutboxStatus {
  PENDING    // Event has been written but not yet dispatched
  DISPATCHED // Event has been successfully delivered to the message bus
  FAILED     // All delivery attempts have been exhausted

  @@map("outbox_status")
}

// ==========================================================================
// Identity and access
// ==========================================================================

/// Core application user. Represents both learners and instructors/admins;
/// the active roles are held in UserRole. Optional fields (targetBand,
/// targetExamDate) are learner-specific goal settings.
model User {
  id             String        @id @default(uuid()) @db.Uuid
  email          String        @unique(map: "uq_app_user_email") @db.VarChar(320)
  passwordHash   String        @map("password_hash") @db.Text
  displayName    String        @map("display_name") @db.VarChar(120)
  status         AccountStatus @default(ACTIVE)
  /// Learner's IELTS target band score (e.g. 7.0).
  targetBand     Decimal?      @map("target_band") @db.Decimal(3, 1)
  /// Date the learner plans to sit the IELTS exam.
  targetExamDate DateTime?     @map("target_exam_date") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  userRoles                      UserRole[]              @relation("UserRole_userId")
  authSessions                   AuthSession[]           @relation("AuthSession_userId")
  instructorApplications         InstructorApplication[] @relation("InstructorApplication_applicantId")
  reviewedInstructorApplications InstructorApplication[] @relation("InstructorApplication_reviewerId")
  fileAssets                     FileAsset[]             @relation("FileAsset_ownerId")
  createdCourses                 Course[]                @relation("Course_creatorId")
  courseAssignments              CourseInstructor[]      @relation("CourseInstructor_instructorId")
  createdActivities              PracticeActivity[]      @relation("PracticeActivity_creatorId")
  enrollments                    Enrollment[]            @relation("Enrollment_learnerId")
  createdAssignments             Assignment[]            @relation("Assignment_creatorId")
  attempts                       Attempt[]               @relation("Attempt_learnerId")
  authoredQuestions              Question[]              @relation("Question_authorId")
  assignedReviewCases            ReviewCase[]            @relation("ReviewCase_assigneeId")
  reviewDecisions                ReviewDecision[]        @relation("ReviewDecision_teacherId")
  appeals                        Appeal[]                @relation("Appeal_requesterId")
  learnerProfiles                LearnerProfileVersion[] @relation("LearnerProfileVersion_learnerId")
  discussionThreads              DiscussionThread[]      @relation("DiscussionThread_creatorId")
  discussionPosts                DiscussionPost[]        @relation("DiscussionPost_authorId")
  notifications                  Notification[]          @relation("Notification_recipientId")
  moderationReports              ModerationReport[]      @relation("ModerationReport_reporterId")
  moderationReportsByResolver    ModerationReport[]      @relation("ModerationReport_resolverId")
  auditEvents                    AuditEvent[]            @relation("AuditEvent_actorId")
  knowledgeDocuments             KnowledgeDocument[]     @relation("KnowledgeDocument_ownerId")
  feedbackExplanations           FeedbackExplanation[]   @relation("FeedbackExplanation_learnerId")

  @@map("APP_USER")
}

/// System role definition. Three roles are supported: LEARNER, INSTRUCTOR, ADMIN.
model Role {
  id   String @id @default(uuid()) @db.Uuid
  /// Short machine-readable code (e.g. "LEARNER", "INSTRUCTOR", "ADMIN").
  code String @unique(map: "uq_role_code") @db.VarChar(30)
  name String @db.VarChar(80)

  userRoles UserRole[] @relation("UserRole_roleId")

  @@map("ROLE")
}

/// Join table that assigns one or more roles to a user. Composite primary key
/// (userId, roleId) ensures no duplicate role grants.
model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  user User @relation("UserRole_userId", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_role_user_id")
  role Role @relation("UserRole_roleId", fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_role_role_id")

  @@id([userId, roleId])
  @@index([roleId], map: "ix_user_role_role_id")
  @@map("USER_ROLE")
}

/// Active refresh-token session. A session is revoked by setting revokedAt;
/// expired sessions are cleaned up by a background job.
model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  /// Bcrypt hash of the opaque refresh token issued to the client.
  refreshTokenHash String    @unique(map: "uq_auth_session_refresh_token_hash") @map("refresh_token_hash") @db.Text
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set when the token is explicitly invalidated (logout / token rotation).
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation("AuthSession_userId", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_auth_session_user_id")

  @@index([userId], map: "ix_auth_session_user_id")
  @@map("AUTH_SESSION")
}

/// Application submitted by a learner who wishes to become an instructor.
/// An admin reviews the application and sets the status to APPROVED or REJECTED.
model InstructorApplication {
  id             String         @id @default(uuid()) @db.Uuid
  applicantId    String         @map("applicant_id") @db.Uuid
  /// The admin user who reviewed this application; NULL while PENDING.
  reviewerId     String?        @map("reviewer_id") @db.Uuid
  status         ApprovalStatus @default(PENDING)
  /// Free-text description of the applicant's qualifications and experience.
  profileText    String         @map("profile_text") @db.Text
  /// Optional rationale provided by the reviewer when approving or rejecting.
  decisionReason String?        @map("decision_reason") @db.Text
  submittedAt    DateTime       @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedAt     DateTime?      @map("reviewed_at") @db.Timestamptz(3)

  applicant User  @relation("InstructorApplication_applicantId", fields: [applicantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_instructor_application_applicant_id")
  reviewer  User? @relation("InstructorApplication_reviewerId", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_instructor_application_reviewer_id")

  @@index([applicantId], map: "ix_instructor_application_applicant_id")
  @@index([reviewerId], map: "ix_instructor_application_reviewer_id")
  @@map("INSTRUCTOR_APPLICATION")
}

/// Metadata record for an uploaded file. The actual binary is stored in
/// object storage; only the lookup key and integrity hash are kept here.
model FileAsset {
  id           String   @id @default(uuid()) @db.Uuid
  ownerId      String   @map("owner_id") @db.Uuid
  /// Unique object key used to retrieve the file from object storage.
  storageKey   String   @unique(map: "uq_file_asset_storage_key") @map("storage_key") @db.Text
  originalName String   @map("original_name") @db.Text
  mimeType     String   @map("mime_type") @db.VarChar(120)
  byteSize     BigInt   @map("byte_size") @db.BigInt
  /// SHA-256 (or similar) hex digest used for deduplication and integrity checks.
  contentHash  String   @map("content_hash") @db.VarChar(128)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  owner                     User                       @relation("FileAsset_ownerId", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_file_asset_owner_id")
  lessonMaterials           LessonMaterial[]           @relation("LessonMaterial_fileAssetId")
  submissionRevisions       SubmissionRevision[]       @relation("SubmissionRevision_audioAssetId")
  questionVersions          QuestionVersion[]          @relation("QuestionVersion_stimulusAssetId")
  knowledgeDocumentVersions KnowledgeDocumentVersion[] @relation("KnowledgeDocumentVersion_fileAssetId")

  @@index([ownerId], map: "ix_file_asset_owner_id")
  @@map("FILE_ASSET")
}

// ==========================================================================
// Courses and learning content
// ==========================================================================

/// A top-level learning course. Contains chapters, learning items, and
/// assignments. Enrollment must be open before learners can join.
model Course {
  id                   String            @id @default(uuid()) @db.Uuid
  creatorId            String            @map("creator_id") @db.Uuid
  title                String            @db.VarChar(240)
  description          String            @db.Text
  status               PublicationStatus @default(DRAFT)
  /// When true, learners can self-enroll. When false, enrollment is invite-only.
  enrollmentOpen       Boolean           @default(false) @map("enrollment_open")
  /// JSON policy that defines what counts as course completion.
  completionPolicyJson Json              @map("completion_policy_json") @db.JsonB
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  creator            User                @relation("Course_creatorId", fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_course_creator_id")
  courseInstructors  CourseInstructor[]  @relation("CourseInstructor_courseId")
  chapters           Chapter[]           @relation("Chapter_courseId")
  learningItems      LearningItem[]      @relation("LearningItem_courseId")
  enrollments        Enrollment[]        @relation("Enrollment_courseId")
  assignments        Assignment[]        @relation("Assignment_courseId")
  discussionThreads  DiscussionThread[]  @relation("DiscussionThread_courseId")
  moderationReports  ModerationReport[]  @relation("ModerationReport_courseId")
  knowledgeDocuments KnowledgeDocument[] @relation("KnowledgeDocument_courseId")

  @@index([creatorId], map: "ix_course_creator_id")
  @@map("COURSE")
}

/// Associates an instructor user with a course and describes their
/// responsibility (e.g. "LEAD", "ASSISTANT").
model CourseInstructor {
  courseId       String   @map("course_id") @db.Uuid
  instructorId   String   @map("instructor_id") @db.Uuid
  /// Role/responsibility of this instructor within the course.
  responsibility String   @db.VarChar(30)
  assignedAt     DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  course     Course @relation("CourseInstructor_courseId", fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_course_instructor_course_id")
  instructor User   @relation("CourseInstructor_instructorId", fields: [instructorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_course_instructor_instructor_id")

  @@id([courseId, instructorId])
  @@index([instructorId], map: "ix_course_instructor_instructor_id")
  @@map("COURSE_INSTRUCTOR")
}

/// An ordered section within a course. Chapters group related learning items
/// and help learners navigate the curriculum.
model Chapter {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @map("course_id") @db.Uuid
  title    String @db.VarChar(240)
  /// 1-based display order within the course; unique per course.
  position Int

  course        Course         @relation("Chapter_courseId", fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_chapter_course_id")
  learningItems LearningItem[] @relation("LearningItem_chapterId_courseId")

  @@unique([courseId, position], map: "uq_chapter_course_id_position")
  @@unique([id, courseId], map: "uq_chapter_id_course_id")
  @@map("CHAPTER")
}

/// Supertype for LESSON and PRACTICE_ACTIVITY (total, disjoint inheritance).
/// The `kind` column is the discriminator; recommendation and skill tags
/// point to this table as the real FK destination.
model LearningItem {
  id        String            @id @default(uuid()) @db.Uuid
  courseId  String            @map("course_id") @db.Uuid
  /// Optional grouping chapter; NULL means the item is not assigned to a chapter.
  chapterId String?           @map("chapter_id") @db.Uuid
  kind      LearningItemKind
  title     String            @db.VarChar(240)
  status    PublicationStatus @default(DRAFT)
  /// 1-based display order within the course.
  position  Int

  course              Course               @relation("LearningItem_courseId", fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_learning_item_course_id")
  chapter             Chapter?             @relation("LearningItem_chapterId_courseId", fields: [chapterId, courseId], references: [id, courseId], onDelete: Restrict, onUpdate: Restrict, map: "fk_learning_item_chapter_id_course_id")
  lesson              Lesson?              @relation("Lesson_id_kind")
  practiceActivity    PracticeActivity?    @relation("PracticeActivity_id_kind")
  learningItemSkills  LearningItemSkill[]  @relation("LearningItemSkill_learningItemId")
  recommendationItems RecommendationItem[] @relation("RecommendationItem_learningItemId")
  discussionThreads   DiscussionThread[]   @relation("DiscussionThread_contextItemId")
  moderationReports   ModerationReport[]   @relation("ModerationReport_learningItemId")
  knowledgeDocuments  KnowledgeDocument[]  @relation("KnowledgeDocument_sourceItemId")

  @@unique([id, kind], map: "uq_learning_item_id_kind")
  @@index([courseId], map: "ix_learning_item_course_id")
  @@index([chapterId, courseId], map: "ix_learning_item_chapter_id_course_id")
  @@map("LEARNING_ITEM")
}

/// Lesson subtype of LearningItem. The `kind` column is fixed to LESSON and
/// is part of the composite FK back to LearningItem to enforce type safety.
model Lesson {
  id      String           @id @db.Uuid
  kind    LearningItemKind @default(LESSON)
  /// Short introductory text shown to learners before reading the materials.
  summary String?          @db.Text

  learningItem     LearningItem     @relation("Lesson_id_kind", fields: [id, kind], references: [id, kind], onDelete: Restrict, onUpdate: Restrict, map: "fk_lesson_id_kind")
  lessonMaterials  LessonMaterial[] @relation("LessonMaterial_lessonId")
  lessonProgresses LessonProgress[] @relation("LessonProgress_lessonId")
  assignments      Assignment[]     @relation("Assignment_contextLessonId")

  @@unique([id, kind], map: "uq_lesson_id_kind")
  @@map("LESSON")
}

/// Practice activity subtype of LearningItem. The `kind` column is fixed to
/// PRACTICE. Content is versioned via ActivityVersion so past attempts remain
/// assessable against the version in use at submission time.
model PracticeActivity {
  id           String           @id @db.Uuid
  kind         LearningItemKind @default(PRACTICE)
  creatorId    String           @map("creator_id") @db.Uuid
  /// IELTS skill area this activity targets (READING, LISTENING, WRITING, SPEAKING).
  skillArea    SkillArea        @map("skill_area")
  /// How learners submit their answer (OBJECTIVE, WRITING, SPEAKING).
  responseMode ResponseMode     @map("response_mode")

  learningItem     LearningItem      @relation("PracticeActivity_id_kind", fields: [id, kind], references: [id, kind], onDelete: Restrict, onUpdate: Restrict, map: "fk_practice_activity_id_kind")
  creator          User              @relation("PracticeActivity_creatorId", fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_practice_activity_creator_id")
  activityVersions ActivityVersion[] @relation("ActivityVersion_activityId")
  assignments      Assignment[]      @relation("Assignment_activityId")

  @@unique([id, kind], map: "uq_practice_activity_id_kind")
  @@index([creatorId], map: "ix_practice_activity_creator_id")
  @@map("PRACTICE_ACTIVITY")
}

/// A single piece of content within a lesson (text block, external URL, or
/// uploaded file). Exactly one payload field should be non-NULL per record,
/// matching the `kind` column. Records are ordered by `position`.
model LessonMaterial {
  id          String       @id @default(uuid()) @db.Uuid
  lessonId    String       @map("lesson_id") @db.Uuid
  kind        MaterialKind
  /// 1-based display order within the lesson.
  position    Int
  /// Populated when kind = TEXT; holds the rich-text body.
  contentText String?      @map("content_text") @db.Text
  /// Populated when kind = URL; holds the external hyperlink.
  externalUrl String?      @map("external_url") @db.Text
  /// Populated when kind = FILE; foreign key to the uploaded FileAsset.
  fileAssetId String?      @map("file_asset_id") @db.Uuid

  lesson    Lesson     @relation("LessonMaterial_lessonId", fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_lesson_material_lesson_id")
  fileAsset FileAsset? @relation("LessonMaterial_fileAssetId", fields: [fileAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_lesson_material_file_asset_id")

  @@unique([lessonId, position], map: "uq_lesson_material_lesson_id_position")
  @@index([fileAssetId], map: "ix_lesson_material_file_asset_id")
  @@map("LESSON_MATERIAL")
}

/// One enrollment per learner-course pair. If a learner leaves and re-enrolls,
/// the same record is updated (leftAt is cleared) rather than creating a new one.
model Enrollment {
  id          String    @id @default(uuid()) @db.Uuid
  learnerId   String    @map("learner_id") @db.Uuid
  courseId    String    @map("course_id") @db.Uuid
  /// Current enrollment state (e.g. "ACTIVE", "LEFT", "COMPLETED").
  status      String    @default("ACTIVE") @db.VarChar(24)
  enrolledAt  DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz(3)
  /// Set when the learner voluntarily leaves the course.
  leftAt      DateTime? @map("left_at") @db.Timestamptz(3)
  /// Set when the learner satisfies the course completion policy.
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  learner          User             @relation("Enrollment_learnerId", fields: [learnerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_enrollment_learner_id")
  course           Course           @relation("Enrollment_courseId", fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_enrollment_course_id")
  lessonProgresses LessonProgress[] @relation("LessonProgress_enrollmentId")

  @@unique([learnerId, courseId], map: "uq_enrollment_learner_id_course_id")
  @@index([courseId], map: "ix_enrollment_course_id")
  @@map("ENROLLMENT")
}

/// Per-lesson progress tracker scoped to an enrollment. Tracks the last
/// position the learner reached (e.g. scroll offset or video timestamp) and
/// completion state. The lesson must belong to the enrollment's course.
model LessonProgress {
  enrollmentId     String    @map("enrollment_id") @db.Uuid
  lessonId         String    @map("lesson_id") @db.Uuid
  /// Current progress state (e.g. "NOT_STARTED", "IN_PROGRESS", "COMPLETED").
  status           String    @default("NOT_STARTED") @db.VarChar(24)
  /// JSON snapshot of the learner's last scroll/playback position.
  lastPositionJson Json?     @map("last_position_json") @db.JsonB
  lastAccessedAt   DateTime  @default(now()) @map("last_accessed_at") @db.Timestamptz(3)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(3)

  enrollment Enrollment @relation("LessonProgress_enrollmentId", fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_lesson_progress_enrollment_id")
  lesson     Lesson     @relation("LessonProgress_lessonId", fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_lesson_progress_lesson_id")

  @@id([enrollmentId, lessonId])
  @@index([lessonId], map: "ix_lesson_progress_lesson_id")
  @@map("LESSON_PROGRESS")
}

// ==========================================================================
// Questions, assignments and immutable submissions
// ==========================================================================

/// Immutable snapshot of an activity's prompt and configuration. Once a
/// version has been used in a submission it must not be changed; create a
/// new version instead. The response mode and skill area are inherited from
/// the parent PracticeActivity and cannot change between versions.
model ActivityVersion {
  id              String    @id @default(uuid()) @db.Uuid
  activityId      String    @map("activity_id") @db.Uuid
  /// Monotonically increasing version number; starts at 1.
  versionNo       Int       @default(1) @map("version_no")
  /// The main task description shown to the learner.
  promptText      String    @map("prompt_text") @db.Text
  /// Step-by-step instructions for completing the activity.
  instructions    String    @db.Text
  /// Relative difficulty rating (e.g. 1 = easy, 5 = very hard).
  difficulty      Int
  /// Estimated time to complete the activity, in minutes.
  expectedMinutes Int       @map("expected_minutes")
  /// Set when the version is published and made available for assignments.
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(3)
  /// SHA-256 hash of the canonical content; used to detect duplicate versions.
  contentHash     String    @map("content_hash") @db.VarChar(128)

  activity            PracticeActivity     @relation("ActivityVersion_activityId", fields: [activityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_activity_version_activity_id")
  assignmentVersions  AssignmentVersion[]  @relation("AssignmentVersion_activityVersionId_activityId")
  assessmentItems     AssessmentItem[]     @relation("AssessmentItem_activityVersionId")
  answerKeyVersions   AnswerKeyVersion[]   @relation("AnswerKeyVersion_activityVersionId")
  recommendationItems RecommendationItem[] @relation("RecommendationItem_targetActivityVersionId_learningItemId")

  @@unique([activityId, versionNo], map: "uq_activity_version_activity_id_version_no")
  @@unique([id, activityId], map: "uq_activity_version_id_activity_id")
  @@map("ACTIVITY_VERSION")
}

/// An assignment ties a PracticeActivity to a Course and optionally to a
/// context Lesson. It is the instructor-facing entity; learners interact with
/// the versioned AssignmentVersion.
model Assignment {
  id              String  @id @default(uuid()) @db.Uuid
  courseId        String  @map("course_id") @db.Uuid
  activityId      String  @map("activity_id") @db.Uuid
  /// Optional lesson whose content provides context for this assignment.
  contextLessonId String? @map("context_lesson_id") @db.Uuid
  creatorId       String  @map("creator_id") @db.Uuid
  title           String  @db.VarChar(240)

  course             Course              @relation("Assignment_courseId", fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assignment_course_id")
  activity           PracticeActivity    @relation("Assignment_activityId", fields: [activityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assignment_activity_id")
  contextLesson      Lesson?             @relation("Assignment_contextLessonId", fields: [contextLessonId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assignment_context_lesson_id")
  creator            User                @relation("Assignment_creatorId", fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assignment_creator_id")
  assignmentVersions AssignmentVersion[] @relation("AssignmentVersion_assignmentId_activityId")

  @@unique([id, activityId], map: "uq_assignment_id_activity_id")
  @@index([courseId], map: "ix_assignment_course_id")
  @@index([activityId], map: "ix_assignment_activity_id")
  @@index([contextLessonId], map: "ix_assignment_context_lesson_id")
  @@index([creatorId], map: "ix_assignment_creator_id")
  @@map("ASSIGNMENT")
}

/// A published snapshot of an assignment's settings (time window, attempt
/// limits, rubric, grading policy, etc.). Publishing a new version does not
/// invalidate attempts taken against an older version.
model AssignmentVersion {
  id                String         @id @default(uuid()) @db.Uuid
  assignmentId      String         @map("assignment_id") @db.Uuid
  /// Denormalised activityId for use in composite FK to ActivityVersion.
  activityId        String         @map("activity_id") @db.Uuid
  activityVersionId String         @map("activity_version_id") @db.Uuid
  /// Optional rubric attached to this version for holistic/criteria scoring.
  rubricVersionId   String?        @map("rubric_version_id") @db.Uuid
  versionNo         Int            @default(1) @map("version_no")
  mode              AssignmentMode
  /// When the assignment window opens; NULL means immediately available.
  opensAt           DateTime?      @map("opens_at") @db.Timestamptz(3)
  /// Hard deadline; NULL means no due date.
  dueAt             DateTime?      @map("due_at") @db.Timestamptz(3)
  /// Per-attempt time limit in seconds; NULL means no limit.
  timeLimitSeconds  Int?           @map("time_limit_seconds")
  /// Maximum number of attempts a learner may make.
  maxAttempts       Int            @default(1) @map("max_attempts")
  /// Maximum number of submission revisions allowed within one attempt.
  maxRevisions      Int            @default(1) @map("max_revisions")
  /// Whether late submissions are accepted after dueAt.
  allowLate         Boolean        @default(false) @map("allow_late")
  /// JSON policy controlling when results are released to the learner.
  releasePolicyJson Json           @map("release_policy_json") @db.JsonB
  publishedAt       DateTime?      @map("published_at") @db.Timestamptz(3)

  assignment          Assignment           @relation("AssignmentVersion_assignmentId_activityId", fields: [assignmentId, activityId], references: [id, activityId], onDelete: Restrict, onUpdate: Restrict, map: "fk_assignment_version_assignment_id_activity_id")
  activityVersion     ActivityVersion      @relation("AssignmentVersion_activityVersionId_activityId", fields: [activityVersionId, activityId], references: [id, activityId], onDelete: Restrict, onUpdate: Restrict, map: "fk_assignment_version_activity_version_id_activity_id")
  rubricVersion       RubricVersion?       @relation("AssignmentVersion_rubricVersionId", fields: [rubricVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assignment_version_rubric_version_id")
  attempts            Attempt[]            @relation("Attempt_assignmentVersionId_assignmentId_activityVersionId")
  recommendationItems RecommendationItem[] @relation("RecommendationItem_targetAssignmentVersionId_targetActivityVersionId_learningItemId")

  @@unique([assignmentId, versionNo], map: "uq_assignment_version_assignment_id_version_no")
  @@unique([id, assignmentId, activityVersionId], map: "uq_assignment_version_id_assignment_id_activity_version_id")
  @@unique([id, activityVersionId, activityId], map: "uq_assignment_version_id_activity_version_id_activity_id")
  @@index([assignmentId, activityId], map: "ix_assignment_version_assignment_id_activity_id")
  @@index([activityVersionId, activityId], map: "ix_assignment_version_activity_version_id_activity_id")
  @@index([rubricVersionId], map: "ix_assignment_version_rubric_version_id")
  @@map("ASSIGNMENT_VERSION")
}

/// One attempt by a learner against a specific AssignmentVersion. The attempt
/// number is scoped to the learner-assignment pair. An optional link to a
/// RecommendationItem records when the attempt was triggered by the system's
/// recommendation engine.
model Attempt {
  id                   String        @id @default(uuid()) @db.Uuid
  learnerId            String        @map("learner_id") @db.Uuid
  assignmentId         String        @map("assignment_id") @db.Uuid
  assignmentVersionId  String        @map("assignment_version_id") @db.Uuid
  /// Denormalised activityVersionId for composite FK integrity checks.
  activityVersionId    String        @map("activity_version_id") @db.Uuid
  /// 1-based attempt sequence number for this learner-assignment pair.
  attemptNo            Int           @default(1) @map("attempt_no")
  status               AttemptStatus @default(IN_PROGRESS)
  startedAt            DateTime      @default(now()) @map("started_at") @db.Timestamptz(3)
  /// Wall-clock deadline for timed assignments; NULL if no time limit applies.
  expiresAt            DateTime?     @map("expires_at") @db.Timestamptz(3)
  /// Set when the attempt reaches a terminal state (FINISHED or CANCELLED).
  finishedAt           DateTime?     @map("finished_at") @db.Timestamptz(3)
  /// Links this attempt to the recommendation that suggested it, if any.
  recommendationItemId String?       @map("recommendation_item_id") @db.Uuid

  learner             User                 @relation("Attempt_learnerId", fields: [learnerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_attempt_learner_id")
  assignmentVersion   AssignmentVersion    @relation("Attempt_assignmentVersionId_assignmentId_activityVersionId", fields: [assignmentVersionId, assignmentId, activityVersionId], references: [id, assignmentId, activityVersionId], onDelete: Restrict, onUpdate: Restrict, map: "fk_attempt_assignment_version_id_assignment_id_a_a328be50f6")
  recommendationItem  RecommendationItem?  @relation("Attempt_recommendationItemId_assignmentVersionId_activityVersionId", fields: [recommendationItemId, assignmentVersionId, activityVersionId], references: [id, targetAssignmentVersionId, targetActivityVersionId], onDelete: Restrict, onUpdate: Restrict, map: "fk_attempt_recommendation_item_id_assignment_ver_7ecffb77ab")
  attemptDraft        AttemptDraft?        @relation("AttemptDraft_attemptId")
  submissionRevisions SubmissionRevision[] @relation("SubmissionRevision_attemptId")

  @@unique([learnerId, assignmentId, attemptNo], map: "uq_attempt_learner_id_assignment_id_attempt_no")
  @@index([assignmentVersionId, assignmentId, activityVersionId], map: "ix_attempt_assignment_version_id_assignment_id_a_c9178d26c0")
  @@index([recommendationItemId, assignmentVersionId, activityVersionId], map: "ix_attempt_recommendation_item_id_assignment_ver_292a408155")
  @@map("ATTEMPT")
}

/// Temporary in-progress draft saved while the learner is composing their
/// answer. Overwritten on each auto-save; deleted when the attempt is
/// submitted. Uses optimistic locking (lockVersion) to prevent lost updates.
model AttemptDraft {
  attemptId   String   @id @map("attempt_id") @db.Uuid
  /// JSON payload containing the draft answer (structure depends on responseMode).
  payloadJson Json     @map("payload_json") @db.JsonB
  /// Optimistic-locking counter; incremented on every write.
  lockVersion Int      @default(0) @map("lock_version")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  attempt Attempt @relation("AttemptDraft_attemptId", fields: [attemptId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_attempt_draft_attempt_id")

  @@map("ATTEMPT_DRAFT")
}

/// An immutable, numbered submission within an attempt. Revision 1 is the
/// first submission; if the assignment allows revisions (maxRevisions > 1),
/// the learner may submit additional revisions. Only one of writingText or
/// audioAssetId should be populated, depending on the responseMode.
model SubmissionRevision {
  id           String       @id @default(uuid()) @db.Uuid
  attemptId    String       @map("attempt_id") @db.Uuid
  /// 1-based revision number within the attempt.
  revisionNo   Int          @map("revision_no")
  responseMode ResponseMode @map("response_mode")
  /// Free-text writing submission; populated when responseMode = WRITING.
  writingText  String?      @map("writing_text") @db.Text
  /// Uploaded audio recording; populated when responseMode = SPEAKING.
  audioAssetId String?      @map("audio_asset_id") @db.Uuid
  submittedAt  DateTime     @default(now()) @map("submitted_at") @db.Timestamptz(3)
  /// SHA-256 hash of the submission content for immutability verification.
  contentHash  String       @map("content_hash") @db.VarChar(128)

  attempt              Attempt               @relation("SubmissionRevision_attemptId", fields: [attemptId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_submission_revision_attempt_id")
  audioAsset           FileAsset?            @relation("SubmissionRevision_audioAssetId", fields: [audioAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_submission_revision_audio_asset_id")
  revisionParagraphs   RevisionParagraph[]   @relation("RevisionParagraph_revisionId")
  itemResponses        ItemResponse[]        @relation("ItemResponse_revisionId")
  gradingRuns          GradingRun[]          @relation("GradingRun_revisionId")
  assessmentResults    AssessmentResult[]    @relation("AssessmentResult_revisionId")
  reviewCases          ReviewCase[]          @relation("ReviewCase_revisionId")
  feedbackExplanations FeedbackExplanation[] @relation("FeedbackExplanation_revisionId")

  @@unique([attemptId, revisionNo], map: "uq_submission_revision_attempt_id_revision_no")
  @@index([audioAssetId], map: "ix_submission_revision_audio_asset_id")
  @@map("SUBMISSION_REVISION")
}

/// A single paragraph extracted from a writing submission. Paragraphs are
/// used to anchor inline findings to specific text spans, enabling granular
/// feedback highlighting in the UI.
model RevisionParagraph {
  id          String @id @default(uuid()) @db.Uuid
  revisionId  String @map("revision_id") @db.Uuid
  /// 1-based paragraph number within the revision.
  paragraphNo Int    @map("paragraph_no")
  text        String @db.Text
  /// Character offset of the paragraph's first character in the full text.
  startOffset Int    @map("start_offset")
  /// Character offset of the paragraph's last character in the full text.
  endOffset   Int    @map("end_offset")

  revision       SubmissionRevision @relation("RevisionParagraph_revisionId", fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_revision_paragraph_revision_id")
  findingAnchors FindingAnchor[]    @relation("FindingAnchor_paragraphId")

  @@unique([revisionId, paragraphNo], map: "uq_revision_paragraph_revision_id_paragraph_no")
  @@map("REVISION_PARAGRAPH")
}

/// A reusable bank question authored by an instructor. The question's
/// content is versioned through QuestionVersion records; this record holds
/// only the author and classification metadata.
model Question {
  id        String    @id @default(uuid()) @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  skillArea SkillArea @map("skill_area")
  /// Short label used to identify the question in the question bank.
  title     String    @db.VarChar(240)

  author           User              @relation("Question_authorId", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_question_author_id")
  questionVersions QuestionVersion[] @relation("QuestionVersion_questionId")

  @@index([authorId], map: "ix_question_author_id")
  @@map("QUESTION")
}

/// Immutable versioned content of a Question. Once a version has been
/// used in an AssessmentItem it must not be edited; create a new version.
model QuestionVersion {
  id              String       @id @default(uuid()) @db.Uuid
  questionId      String       @map("question_id") @db.Uuid
  versionNo       Int          @default(1) @map("version_no")
  questionType    QuestionType @map("question_type")
  /// The question stem displayed to the learner.
  promptText      String       @map("prompt_text") @db.Text
  /// Optional passage or image description provided alongside the question.
  stimulusText    String?      @map("stimulus_text") @db.Text
  /// Optional file asset (image, audio clip) used as the question stimulus.
  stimulusAssetId String?      @map("stimulus_asset_id") @db.Uuid
  publishedAt     DateTime?    @map("published_at") @db.Timestamptz(3)

  question        Question         @relation("QuestionVersion_questionId", fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_question_version_question_id")
  stimulusAsset   FileAsset?       @relation("QuestionVersion_stimulusAssetId", fields: [stimulusAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_question_version_stimulus_asset_id")
  questionOptions QuestionOption[] @relation("QuestionOption_questionVersionId")
  assessmentItems AssessmentItem[] @relation("AssessmentItem_questionVersionId")

  @@unique([questionId, versionNo], map: "uq_question_version_question_id_version_no")
  @@index([stimulusAssetId], map: "ix_question_version_stimulus_asset_id")
  @@map("QUESTION_VERSION")
}

/// One selectable answer choice for a QuestionVersion. Applicable to
/// SINGLE_CHOICE and MULTIPLE_CHOICE question types.
model QuestionOption {
  id                String @id @default(uuid()) @db.Uuid
  questionVersionId String @map("question_version_id") @db.Uuid
  /// Short code identifying the option (e.g. "A", "B", "C", "D").
  optionCode        String @map("option_code") @db.VarChar(12)
  contentText       String @map("content_text") @db.Text
  /// Display order within the question's option list.
  position          Int

  questionVersion    QuestionVersion     @relation("QuestionOption_questionVersionId", fields: [questionVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_question_option_question_version_id")
  answerKeyOptions   AnswerKeyOption[]   @relation("AnswerKeyOption_optionId")
  responseSelections ResponseSelection[] @relation("ResponseSelection_optionId")

  @@unique([questionVersionId, optionCode], map: "uq_question_option_question_version_id_option_code")
  @@unique([questionVersionId, position], map: "uq_question_option_question_version_id_position")
  @@map("QUESTION_OPTION")
}

/// Positions a specific QuestionVersion within an ActivityVersion, setting its
/// display order and the maximum marks it can earn.
model AssessmentItem {
  id                String  @id @default(uuid()) @db.Uuid
  activityVersionId String  @map("activity_version_id") @db.Uuid
  questionVersionId String  @map("question_version_id") @db.Uuid
  /// 1-based display order within the activity.
  position          Int
  /// Optional heading used when the activity is divided into sections.
  sectionLabel      String? @map("section_label") @db.VarChar(120)
  /// Maximum marks a learner can earn for this item.
  maxMarks          Decimal @map("max_marks") @db.Decimal(6, 2)

  activityVersion  ActivityVersion  @relation("AssessmentItem_activityVersionId", fields: [activityVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assessment_item_activity_version_id")
  questionVersion  QuestionVersion  @relation("AssessmentItem_questionVersionId", fields: [questionVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assessment_item_question_version_id")
  answerKeyEntries AnswerKeyEntry[] @relation("AnswerKeyEntry_assessmentItemId")
  itemResponses    ItemResponse[]   @relation("ItemResponse_assessmentItemId")
  itemSkills       ItemSkill[]      @relation("ItemSkill_assessmentItemId")

  @@unique([activityVersionId, position], map: "uq_assessment_item_activity_version_id_position")
  @@index([questionVersionId], map: "ix_assessment_item_question_version_id")
  @@map("ASSESSMENT_ITEM")
}

/// A versioned answer key for an ActivityVersion. Multiple versions can exist
/// if the marking scheme is revised; the version used at grading time is
/// recorded in AnswerKeyResult for auditability.
model AnswerKeyVersion {
  id                String    @id @default(uuid()) @db.Uuid
  activityVersionId String    @map("activity_version_id") @db.Uuid
  versionNo         Int       @default(1) @map("version_no")
  /// Optional JSON that maps raw score ranges to band scores.
  scoreMappingJson  Json?     @map("score_mapping_json") @db.JsonB
  publishedAt       DateTime? @map("published_at") @db.Timestamptz(3)

  activityVersion  ActivityVersion   @relation("AnswerKeyVersion_activityVersionId", fields: [activityVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_answer_key_version_activity_version_id")
  answerKeyEntries AnswerKeyEntry[]  @relation("AnswerKeyEntry_answerKeyVersionId")
  answerKeyResults AnswerKeyResult[] @relation("AnswerKeyResult_answerKeyVersionId")

  @@unique([activityVersionId, versionNo], map: "uq_answer_key_version_activity_version_id_version_no")
  @@map("ANSWER_KEY_VERSION")
}

/// Defines the correct answer for one AssessmentItem within an AnswerKeyVersion.
/// The grading rule specifies how to award marks (e.g. exact match, partial
/// credit). Accepted texts apply to SHORT_ANSWER; options apply to choice types.
model AnswerKeyEntry {
  id                 String @id @default(uuid()) @db.Uuid
  answerKeyVersionId String @map("answer_key_version_id") @db.Uuid
  assessmentItemId   String @map("assessment_item_id") @db.Uuid
  /// JSON array of accepted answer strings for short-answer questions.
  acceptedTextsJson  Json?  @map("accepted_texts_json") @db.JsonB
  /// JSON object describing the marking algorithm (e.g. exact-match, regex).
  gradingRuleJson    Json   @map("grading_rule_json") @db.JsonB

  answerKeyVersion AnswerKeyVersion  @relation("AnswerKeyEntry_answerKeyVersionId", fields: [answerKeyVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_answer_key_entry_answer_key_version_id")
  assessmentItem   AssessmentItem    @relation("AnswerKeyEntry_assessmentItemId", fields: [assessmentItemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_answer_key_entry_assessment_item_id")
  answerKeyOptions AnswerKeyOption[] @relation("AnswerKeyOption_entryId")
  questionMarks    QuestionMark[]    @relation("QuestionMark_keyEntryId")

  @@unique([answerKeyVersionId, assessmentItemId], map: "uq_answer_key_entry_answer_key_version_id_assessment_item_id")
  @@index([assessmentItemId], map: "ix_answer_key_entry_assessment_item_id")
  @@map("ANSWER_KEY_ENTRY")
}

/// Join table that designates which QuestionOption values are correct for a
/// given AnswerKeyEntry (used for SINGLE_CHOICE and MULTIPLE_CHOICE items).
model AnswerKeyOption {
  entryId  String @map("entry_id") @db.Uuid
  optionId String @map("option_id") @db.Uuid

  entry  AnswerKeyEntry @relation("AnswerKeyOption_entryId", fields: [entryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_answer_key_option_entry_id")
  option QuestionOption @relation("AnswerKeyOption_optionId", fields: [optionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_answer_key_option_option_id")

  @@id([entryId, optionId])
  @@index([optionId], map: "ix_answer_key_option_option_id")
  @@map("ANSWER_KEY_OPTION")
}

/// Records a learner's answer to one AssessmentItem within a submission
/// revision. textAnswer is used for SHORT_ANSWER; selected options are
/// stored in ResponseSelection.
model ItemResponse {
  id               String  @id @default(uuid()) @db.Uuid
  revisionId       String  @map("revision_id") @db.Uuid
  assessmentItemId String  @map("assessment_item_id") @db.Uuid
  /// Free-text answer provided for SHORT_ANSWER questions.
  textAnswer       String? @map("text_answer") @db.Text

  revision           SubmissionRevision  @relation("ItemResponse_revisionId", fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_item_response_revision_id")
  assessmentItem     AssessmentItem      @relation("ItemResponse_assessmentItemId", fields: [assessmentItemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_item_response_assessment_item_id")
  responseSelections ResponseSelection[] @relation("ResponseSelection_responseId")
  questionMarks      QuestionMark[]      @relation("QuestionMark_responseId")

  @@unique([revisionId, assessmentItemId], map: "uq_item_response_revision_id_assessment_item_id")
  @@index([assessmentItemId], map: "ix_item_response_assessment_item_id")
  @@map("ITEM_RESPONSE")
}

/// Records which QuestionOption(s) a learner selected in a choice-type
/// ItemResponse. One row per selected option.
model ResponseSelection {
  responseId String @map("response_id") @db.Uuid
  optionId   String @map("option_id") @db.Uuid

  response ItemResponse   @relation("ResponseSelection_responseId", fields: [responseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_response_selection_response_id")
  option   QuestionOption @relation("ResponseSelection_optionId", fields: [optionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_response_selection_option_id")

  @@id([responseId, optionId])
  @@index([optionId], map: "ix_response_selection_option_id")
  @@map("RESPONSE_SELECTION")
}

// ==========================================================================
// Rubrics and assessment results
// ==========================================================================

/// A versioned holistic-scoring rubric (e.g. the official IELTS Writing
/// rubric). Multiple versions can exist when the rubric is updated. The
/// rubricCode groups all versions of the same rubric together.
model RubricVersion {
  id          String    @id @default(uuid()) @db.Uuid
  /// Machine-readable identifier shared across all versions of this rubric.
  rubricCode  String    @map("rubric_code") @db.VarChar(60)
  versionNo   Int       @default(1) @map("version_no")
  /// The task type this rubric applies to (e.g. "TASK1", "TASK2").
  taskType    String    @map("task_type") @db.VarChar(60)
  title       String    @db.VarChar(240)
  /// URL of the official rubric document, if published externally.
  sourceUrl   String?   @map("source_url") @db.Text
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  assignmentVersions AssignmentVersion[] @relation("AssignmentVersion_rubricVersionId")
  rubricCriterions   RubricCriterion[]   @relation("RubricCriterion_rubricVersionId")
  gradingConfigs     GradingConfig[]     @relation("GradingConfig_rubricVersionId")
  assessmentResults  AssessmentResult[]  @relation("AssessmentResult_rubricVersionId")

  @@unique([rubricCode, versionNo], map: "uq_rubric_version_rubric_code_version_no")
  @@map("RUBRIC_VERSION")
}

/// One scoring dimension within a RubricVersion (e.g. "Coherence and
/// Cohesion", "Lexical Resource"). Each criterion has a weight and a maximum
/// score, and is described by a set of BandDescriptors.
model RubricCriterion {
  id              String  @id @default(uuid()) @db.Uuid
  rubricVersionId String  @map("rubric_version_id") @db.Uuid
  /// Short code used to reference the criterion programmatically (e.g. "CC").
  code            String  @db.VarChar(30)
  name            String  @db.VarChar(140)
  /// Formal definition of what this criterion measures.
  definition      String  @db.Text
  /// Relative weight of this criterion in the overall band calculation.
  weight          Decimal @db.Decimal(6, 3)
  maxScore        Decimal @map("max_score") @db.Decimal(6, 2)

  rubricVersion   RubricVersion    @relation("RubricCriterion_rubricVersionId", fields: [rubricVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rubric_criterion_rubric_version_id")
  bandDescriptors BandDescriptor[] @relation("BandDescriptor_criterionId")
  criterionScores CriterionScore[] @relation("CriterionScore_criterionId_rubricVersionId")

  @@unique([rubricVersionId, code], map: "uq_rubric_criterion_rubric_version_id_code")
  @@unique([id, rubricVersionId], map: "uq_rubric_criterion_id_rubric_version_id")
  @@map("RUBRIC_CRITERION")
}

/// Describes what a learner's response must look like at a given IELTS band
/// value for a specific RubricCriterion. One row per band per criterion.
model BandDescriptor {
  id          String  @id @default(uuid()) @db.Uuid
  criterionId String  @map("criterion_id") @db.Uuid
  /// IELTS band value this descriptor applies to (e.g. 5.0, 6.0, 7.0).
  bandValue   Decimal @map("band_value") @db.Decimal(3, 1)
  /// Qualitative description of learner performance at this band level.
  description String  @db.Text

  criterion RubricCriterion @relation("BandDescriptor_criterionId", fields: [criterionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_band_descriptor_criterion_id")

  @@unique([criterionId, bandValue], map: "uq_band_descriptor_criterion_id_band_value")
  @@map("BAND_DESCRIPTOR")
}

/// A versioned AI system prompt used during grading. Versioning ensures that
/// older grading runs can be understood and reproduced with the exact prompt
/// that was used at the time.
model PromptVersion {
  id               String   @id @default(uuid()) @db.Uuid
  /// Machine-readable identifier shared across all versions of this prompt.
  promptCode       String   @map("prompt_code") @db.VarChar(60)
  versionNo        Int      @default(1) @map("version_no")
  /// Full system instructions sent to the AI provider.
  instructions     String   @db.Text
  /// JSON Schema describing the structured output expected from the AI.
  outputSchemaJson Json     @map("output_schema_json") @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  gradingConfigs       GradingConfig[]       @relation("GradingConfig_promptVersionId")
  feedbackExplanations FeedbackExplanation[] @relation("FeedbackExplanation_promptVersionId")

  @@unique([promptCode, versionNo], map: "uq_prompt_version_prompt_code_version_no")
  @@map("PROMPT_VERSION")
}

/// Links a RubricVersion to a PromptVersion and records the AI provider and
/// model to use when running the grading pipeline. Multiple configs allow
/// A/B testing of different models or prompts.
model GradingConfig {
  id              String   @id @default(uuid()) @db.Uuid
  rubricVersionId String   @map("rubric_version_id") @db.Uuid
  promptVersionId String   @map("prompt_version_id") @db.Uuid
  /// AI provider name (e.g. "openai", "google", "anthropic").
  provider        String   @db.VarChar(60)
  /// Provider-specific model identifier (e.g. "gpt-4o", "gemini-1.5-pro").
  modelId         String   @map("model_id") @db.VarChar(120)
  /// Provider-specific inference settings (temperature, max_tokens, etc.).
  settingsJson    Json     @map("settings_json") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  rubricVersion RubricVersion @relation("GradingConfig_rubricVersionId", fields: [rubricVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_grading_config_rubric_version_id")
  promptVersion PromptVersion @relation("GradingConfig_promptVersionId", fields: [promptVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_grading_config_prompt_version_id")
  gradingRuns   GradingRun[]  @relation("GradingRun_configId")

  @@index([rubricVersionId], map: "ix_grading_config_rubric_version_id")
  @@index([promptVersionId], map: "ix_grading_config_prompt_version_id")
  @@map("GRADING_CONFIG")
}

/// Tracks one asynchronous AI grading job for a SubmissionRevision. Workers
/// poll for QUEUED runs, claim them with a processing token, and update the
/// status on completion or failure.
model GradingRun {
  id              String    @id @default(uuid()) @db.Uuid
  revisionId      String    @map("revision_id") @db.Uuid
  configId        String    @map("config_id") @db.Uuid
  /// Idempotency key; duplicate submissions with the same key are ignored.
  requestKey      String    @unique(map: "uq_grading_run_request_key") @map("request_key") @db.VarChar(160)
  status          RunStatus @default(QUEUED)
  /// Total number of provider call attempts made so far.
  attempts        Int       @default(0)
  /// UUID assigned to the worker that currently holds the lease; NULL if free.
  processingToken String?   @map("processing_token") @db.Uuid
  /// Timestamp until which the current worker lease is valid.
  leaseUntil      DateTime? @map("lease_until") @db.Timestamptz(3)
  startedAt       DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(3)
  /// Machine-readable error code set when status = FAILED.
  errorCode       String?   @map("error_code") @db.VarChar(80)

  revision         SubmissionRevision @relation("GradingRun_revisionId", fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_grading_run_revision_id")
  config           GradingConfig      @relation("GradingRun_configId", fields: [configId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_grading_run_config_id")
  providerAttempts ProviderAttempt[]  @relation("ProviderAttempt_gradingRunId")
  aiResult         AiResult?          @relation("AiResult_gradingRunId_revisionId")
  reviewCases      ReviewCase[]       @relation("ReviewCase_targetRunId_revisionId")

  @@unique([id, revisionId], map: "uq_grading_run_id_revision_id")
  @@index([revisionId], map: "ix_grading_run_revision_id")
  @@index([configId], map: "ix_grading_run_config_id")
  @@index([status, leaseUntil], map: "ix_grading_run_status_lease_until")
  @@map("GRADING_RUN")
}

/// Records one HTTP call to an AI provider within a GradingRun. A single run
/// may retry multiple times; each attempt is logged here for billing,
/// debugging, and latency analysis.
model ProviderAttempt {
  id                String                @id @default(uuid()) @db.Uuid
  gradingRunId      String                @map("grading_run_id") @db.Uuid
  attemptNo         Int                   @default(1) @map("attempt_no")
  status            ProviderAttemptStatus
  /// Request ID returned by the provider for support/billing tracing.
  providerRequestId String?               @map("provider_request_id") @db.Text
  /// Full raw JSON response from the provider; stored for debugging.
  rawResponseJson   Json?                 @map("raw_response_json") @db.JsonB
  /// Error details if the call failed; NULL on success.
  errorJson         Json?                 @map("error_json") @db.JsonB
  /// Number of tokens in the prompt sent to the provider.
  inputTokens       Int?                  @map("input_tokens")
  /// Number of tokens in the completion returned by the provider.
  outputTokens      Int?                  @map("output_tokens")
  /// End-to-end call latency in milliseconds.
  latencyMs         Int?                  @map("latency_ms")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  gradingRun GradingRun @relation("ProviderAttempt_gradingRunId", fields: [gradingRunId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_provider_attempt_grading_run_id")

  @@unique([gradingRunId, attemptNo], map: "uq_provider_attempt_grading_run_id_attempt_no")
  @@map("PROVIDER_ATTEMPT")
}

/// Polymorphic result container for a submission revision. A single revision
/// may have up to three result rows: one AI, one TEACHER, and one ANSWER_KEY.
/// The rubricVersionId is set only for rubric-based (AI or TEACHER) results.
model AssessmentResult {
  id              String     @id @default(uuid()) @db.Uuid
  revisionId      String     @map("revision_id") @db.Uuid
  /// Source that produced this result (AI, TEACHER, or ANSWER_KEY).
  kind            ResultKind
  /// Rubric used for holistic scoring; NULL for ANSWER_KEY results.
  rubricVersionId String?    @map("rubric_version_id") @db.Uuid
  /// Aggregated overall score; NULL until scoring is complete.
  overallScore    Decimal?   @map("overall_score") @db.Decimal(6, 2)
  scoreScale      ScoreScale @map("score_scale")
  /// High-level textual summary of the result.
  summary         String?    @db.Text
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  revision           SubmissionRevision  @relation("AssessmentResult_revisionId", fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assessment_result_revision_id")
  rubricVersion      RubricVersion?      @relation("AssessmentResult_rubricVersionId", fields: [rubricVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assessment_result_rubric_version_id")
  aiResult           AiResult?           @relation("AiResult_id_kind_revisionId")
  teacherResult      TeacherResult?      @relation("TeacherResult_id_kind_revisionId")
  answerKeyResult    AnswerKeyResult?    @relation("AnswerKeyResult_id_kind_revisionId")
  criterionScores    CriterionScore[]    @relation("CriterionScore_resultId_rubricVersionId")
  findings           Finding[]           @relation("Finding_resultId")
  acceptedAssessment AcceptedAssessment? @relation("AcceptedAssessment_resultId_resultKind_revisionId")
  skillObservations  SkillObservation[]  @relation("SkillObservation_resultId")

  @@unique([id, kind, revisionId], map: "uq_assessment_result_id_kind_revision_id")
  @@unique([id, rubricVersionId], map: "uq_assessment_result_id_rubric_version_id")
  @@index([revisionId], map: "ix_assessment_result_revision_id")
  @@index([rubricVersionId], map: "ix_assessment_result_rubric_version_id")
  @@map("ASSESSMENT_RESULT")
}

/// AI-specific metadata for an AssessmentResult of kind = AI. Records the
/// quality gate outcome and validation details from the post-processing step.
model AiResult {
  id             String        @id @db.Uuid
  kind           ResultKind    @default(AI)
  revisionId     String        @map("revision_id") @db.Uuid
  /// The GradingRun that produced this result; unique 1-to-1 relationship.
  gradingRunId   String        @unique(map: "uq_ai_result_grading_run_id") @map("grading_run_id") @db.Uuid
  /// Whether the result passed automated quality checks.
  qualityStatus  QualityStatus @map("quality_status")
  /// JSON details from the validation pipeline (schema checks, range checks, etc.).
  validationJson Json          @map("validation_json") @db.JsonB

  assessmentResult AssessmentResult @relation("AiResult_id_kind_revisionId", fields: [id, kind, revisionId], references: [id, kind, revisionId], onDelete: Restrict, onUpdate: Restrict, map: "fk_ai_result_id_kind_revision_id")
  gradingRun       GradingRun       @relation("AiResult_gradingRunId_revisionId", fields: [gradingRunId, revisionId], references: [id, revisionId], onDelete: Restrict, onUpdate: Restrict, map: "fk_ai_result_grading_run_id_revision_id")

  @@unique([id, kind, revisionId], map: "uq_ai_result_id_kind_revision_id")
  @@unique([gradingRunId, revisionId], map: "uq_ai_result_grading_run_id_revision_id")
  @@map("AI_RESULT")
}

/// Teacher-specific metadata for an AssessmentResult of kind = TEACHER.
/// Links the result back to the ReviewDecision that produced it.
model TeacherResult {
  id         String     @id @db.Uuid
  kind       ResultKind @default(TEACHER)
  revisionId String     @map("revision_id") @db.Uuid
  /// The review decision that generated this teacher result.
  decisionId String     @unique(map: "uq_teacher_result_decision_id") @map("decision_id") @db.Uuid

  assessmentResult AssessmentResult @relation("TeacherResult_id_kind_revisionId", fields: [id, kind, revisionId], references: [id, kind, revisionId], onDelete: Restrict, onUpdate: Restrict, map: "fk_teacher_result_id_kind_revision_id")
  decision         ReviewDecision   @relation("TeacherResult_decisionId_revisionId", fields: [decisionId, revisionId], references: [id, revisionId], onDelete: Restrict, onUpdate: Restrict, map: "fk_teacher_result_decision_id_revision_id")

  @@unique([id, kind, revisionId], map: "uq_teacher_result_id_kind_revision_id")
  @@unique([decisionId, revisionId], map: "uq_teacher_result_decision_id_revision_id")
  @@map("TEACHER_RESULT")
}

/// Answer-key-specific metadata for an AssessmentResult of kind = ANSWER_KEY.
/// Stores the raw marks and the version of the answer key that was applied.
model AnswerKeyResult {
  id                 String     @id @db.Uuid
  kind               ResultKind @default(ANSWER_KEY)
  revisionId         String     @map("revision_id") @db.Uuid
  answerKeyVersionId String     @map("answer_key_version_id") @db.Uuid
  /// Total marks awarded across all assessment items.
  rawScore           Decimal    @map("raw_score") @db.Decimal(6, 2)
  /// Maximum possible marks from the answer key.
  maxScore           Decimal    @map("max_score") @db.Decimal(6, 2)

  assessmentResult AssessmentResult @relation("AnswerKeyResult_id_kind_revisionId", fields: [id, kind, revisionId], references: [id, kind, revisionId], onDelete: Restrict, onUpdate: Restrict, map: "fk_answer_key_result_id_kind_revision_id")
  answerKeyVersion AnswerKeyVersion @relation("AnswerKeyResult_answerKeyVersionId", fields: [answerKeyVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_answer_key_result_answer_key_version_id")
  questionMarks    QuestionMark[]   @relation("QuestionMark_answerKeyResultId")

  @@unique([id, kind, revisionId], map: "uq_answer_key_result_id_kind_revision_id")
  @@index([answerKeyVersionId], map: "ix_answer_key_result_answer_key_version_id")
  @@map("ANSWER_KEY_RESULT")
}

/// Per-criterion score within an AssessmentResult that uses a rubric.
/// One row per RubricCriterion per result.
model CriterionScore {
  id              String  @id @default(uuid()) @db.Uuid
  resultId        String  @map("result_id") @db.Uuid
  /// Denormalised rubric version for enforcing the composite FK.
  rubricVersionId String  @map("rubric_version_id") @db.Uuid
  criterionId     String  @map("criterion_id") @db.Uuid
  /// Score awarded for this criterion (must be <= RubricCriterion.maxScore).
  score           Decimal @db.Decimal(6, 2)
  /// Textual justification for the awarded score.
  explanation     String? @db.Text

  result    AssessmentResult @relation("CriterionScore_resultId_rubricVersionId", fields: [resultId, rubricVersionId], references: [id, rubricVersionId], onDelete: Restrict, onUpdate: Restrict, map: "fk_criterion_score_result_id_rubric_version_id")
  criterion RubricCriterion  @relation("CriterionScore_criterionId_rubricVersionId", fields: [criterionId, rubricVersionId], references: [id, rubricVersionId], onDelete: Restrict, onUpdate: Restrict, map: "fk_criterion_score_criterion_id_rubric_version_id")
  findings  Finding[]        @relation("Finding_criterionScoreId_resultId")

  @@unique([resultId, criterionId], map: "uq_criterion_score_result_id_criterion_id")
  @@unique([id, resultId], map: "uq_criterion_score_id_result_id")
  @@index([resultId, rubricVersionId], map: "ix_criterion_score_result_id_rubric_version_id")
  @@index([criterionId, rubricVersionId], map: "ix_criterion_score_criterion_id_rubric_version_id")
  @@map("CRITERION_SCORE")
}

/// Records the marks awarded for one learner response against one answer key
/// entry. Exists only for ANSWER_KEY results.
model QuestionMark {
  id                String  @id @default(uuid()) @db.Uuid
  answerKeyResultId String  @map("answer_key_result_id") @db.Uuid
  responseId        String  @map("response_id") @db.Uuid
  keyEntryId        String  @map("key_entry_id") @db.Uuid
  /// Actual marks awarded (may be fractional for partial-credit schemes).
  awardedMarks      Decimal @map("awarded_marks") @db.Decimal(6, 2)
  /// Optional explanation of why these marks were awarded.
  explanation       String? @db.Text

  answerKeyResult AnswerKeyResult @relation("QuestionMark_answerKeyResultId", fields: [answerKeyResultId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_question_mark_answer_key_result_id")
  response        ItemResponse    @relation("QuestionMark_responseId", fields: [responseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_question_mark_response_id")
  keyEntry        AnswerKeyEntry  @relation("QuestionMark_keyEntryId", fields: [keyEntryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_question_mark_key_entry_id")

  @@unique([answerKeyResultId, responseId], map: "uq_question_mark_answer_key_result_id_response_id")
  @@index([responseId], map: "ix_question_mark_response_id")
  @@index([keyEntryId], map: "ix_question_mark_key_entry_id")
  @@map("QUESTION_MARK")
}

/// An individual piece of feedback (error, strength, suggestion) attached to
/// an AssessmentResult. Optionally linked to a specific CriterionScore or Skill,
/// and to text spans via FindingAnchor records.
model Finding {
  id               String  @id @default(uuid()) @db.Uuid
  resultId         String  @map("result_id") @db.Uuid
  /// The criterion this finding relates to; NULL for cross-criterion findings.
  criterionScoreId String? @map("criterion_score_id") @db.Uuid
  /// The skill this finding relates to; NULL if not skill-mapped.
  skillId          String? @map("skill_id") @db.Uuid
  /// Category of the finding (e.g. "ERROR", "STRENGTH", "SUGGESTION").
  findingKind      String  @map("finding_kind") @db.VarChar(30)
  /// Human-readable feedback text shown to the learner.
  explanation      String  @db.Text
  /// JSON validation metadata (confidence scores, rule IDs, etc.).
  validationJson   Json?   @map("validation_json") @db.JsonB

  result               AssessmentResult      @relation("Finding_resultId", fields: [resultId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_finding_result_id")
  criterionScore       CriterionScore?       @relation("Finding_criterionScoreId_resultId", fields: [criterionScoreId, resultId], references: [id, resultId], onDelete: Restrict, onUpdate: Restrict, map: "fk_finding_criterion_score_id_result_id")
  skill                Skill?                @relation("Finding_skillId", fields: [skillId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_finding_skill_id")
  findingAnchors       FindingAnchor[]       @relation("FindingAnchor_findingId")
  feedbackExplanations FeedbackExplanation[] @relation("FeedbackExplanation_findingId")

  @@index([resultId], map: "ix_finding_result_id")
  @@index([criterionScoreId, resultId], map: "ix_finding_criterion_score_id_result_id")
  @@index([skillId], map: "ix_finding_skill_id")
  @@map("FINDING")
}

/// Pins a Finding to a specific character range within a RevisionParagraph,
/// enabling the UI to highlight the exact text that triggered the feedback.
model FindingAnchor {
  id          String @id @default(uuid()) @db.Uuid
  findingId   String @map("finding_id") @db.Uuid
  paragraphId String @map("paragraph_id") @db.Uuid
  /// Start character offset within the paragraph's text.
  startOffset Int    @map("start_offset")
  /// End character offset within the paragraph's text.
  endOffset   Int    @map("end_offset")
  /// The exact text span that was highlighted; used as a human-readable anchor.
  exactQuote  String @map("exact_quote") @db.Text

  finding   Finding           @relation("FindingAnchor_findingId", fields: [findingId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_finding_anchor_finding_id")
  paragraph RevisionParagraph @relation("FindingAnchor_paragraphId", fields: [paragraphId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_finding_anchor_paragraph_id")

  @@index([findingId], map: "ix_finding_anchor_finding_id")
  @@index([paragraphId], map: "ix_finding_anchor_paragraph_id")
  @@map("FINDING_ANCHOR")
}

// ==========================================================================
// Instructor review and accepted publication
// ==========================================================================

/// A work item that queues a SubmissionRevision for manual teacher review.
/// Created automatically when an AI result is flagged or when business rules
/// require human oversight. Priority determines queue order.
model ReviewCase {
  id          String       @id @default(uuid()) @db.Uuid
  revisionId  String       @map("revision_id") @db.Uuid
  /// The AI GradingRun being reviewed; NULL for non-AI-triggered cases.
  targetRunId String?      @map("target_run_id") @db.Uuid
  /// Teacher currently assigned to this case; NULL until claimed.
  assigneeId  String?      @map("assignee_id") @db.Uuid
  status      ReviewStatus @default(PENDING)
  /// Machine-readable reason the case was created (e.g. "QUALITY_FLAGGED").
  reasonCode  String       @map("reason_code") @db.VarChar(60)
  /// Higher priority values are surfaced first in the review queue.
  priority    Int
  /// Optimistic-locking counter to prevent concurrent claim conflicts.
  lockVersion Int          @default(0) @map("lock_version")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Timestamp when a teacher claimed the case.
  claimedAt   DateTime?    @map("claimed_at") @db.Timestamptz(3)

  revision        SubmissionRevision @relation("ReviewCase_revisionId", fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_review_case_revision_id")
  targetRun       GradingRun?        @relation("ReviewCase_targetRunId_revisionId", fields: [targetRunId, revisionId], references: [id, revisionId], onDelete: Restrict, onUpdate: Restrict, map: "fk_review_case_target_run_id_revision_id")
  assignee        User?              @relation("ReviewCase_assigneeId", fields: [assigneeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_review_case_assignee_id")
  reviewDecisions ReviewDecision[]   @relation("ReviewDecision_reviewCaseId_revisionId")
  appeals         Appeal[]           @relation("Appeal_reviewCaseId_revisionId")

  @@unique([id, revisionId], map: "uq_review_case_id_revision_id")
  @@index([revisionId], map: "ix_review_case_revision_id")
  @@index([targetRunId, revisionId], map: "ix_review_case_target_run_id_revision_id")
  @@index([assigneeId], map: "ix_review_case_assignee_id")
  @@index([status, priority, createdAt], map: "ix_review_case_status_priority_created_at")
  @@map("REVIEW_CASE")
}

/// A formal grading decision made by a teacher for a ReviewCase. If a
/// decision is superseded (e.g. corrected), the new decision references the
/// old one via supersedesId and produces a new TeacherResult.
model ReviewDecision {
  id           String   @id @default(uuid()) @db.Uuid
  reviewCaseId String   @map("review_case_id") @db.Uuid
  /// Denormalised revisionId for composite FK to TeacherResult.
  revisionId   String   @map("revision_id") @db.Uuid
  teacherId    String   @map("teacher_id") @db.Uuid
  /// 1-based sequence number within the review case.
  decisionNo   Int      @map("decision_no")
  /// Decision that this one supersedes (non-NULL when correcting a mistake).
  supersedesId String?  @map("supersedes_id") @db.Uuid
  /// Teacher's written justification for the scores awarded.
  reason       String   @db.Text
  decidedAt    DateTime @default(now()) @map("decided_at") @db.Timestamptz(3)

  teacherResult   TeacherResult?   @relation("TeacherResult_decisionId_revisionId")
  reviewCase      ReviewCase       @relation("ReviewDecision_reviewCaseId_revisionId", fields: [reviewCaseId, revisionId], references: [id, revisionId], onDelete: Restrict, onUpdate: Restrict, map: "fk_review_decision_review_case_id_revision_id")
  teacher         User             @relation("ReviewDecision_teacherId", fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_review_decision_teacher_id")
  supersedes      ReviewDecision?  @relation("ReviewDecision_supersedesId", fields: [supersedesId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_review_decision_supersedes_id")
  reviewDecisions ReviewDecision[] @relation("ReviewDecision_supersedesId")

  @@unique([reviewCaseId, decisionNo], map: "uq_review_decision_review_case_id_decision_no")
  @@unique([id, revisionId], map: "uq_review_decision_id_revision_id")
  @@index([reviewCaseId, revisionId], map: "ix_review_decision_review_case_id_revision_id")
  @@index([teacherId], map: "ix_review_decision_teacher_id")
  @@index([supersedesId], map: "ix_review_decision_supersedes_id")
  @@map("REVIEW_DECISION")
}

/// The canonical result that has been accepted for publication to the learner.
/// At most one accepted assessment should have isCurrent = true per revision.
/// When a result is superseded (e.g. after an appeal), supersedesId points
/// to the previous accepted assessment.
model AcceptedAssessment {
  id           String     @id @default(uuid()) @db.Uuid
  resultId     String     @unique(map: "uq_accepted_assessment_result_id") @map("result_id") @db.Uuid
  resultKind   ResultKind @map("result_kind")
  revisionId   String     @map("revision_id") @db.Uuid
  acceptedAt   DateTime   @default(now()) @map("accepted_at") @db.Timestamptz(3)
  /// If set, the result is embargoed until this time before being shown to the learner.
  releaseAfter DateTime?  @map("release_after") @db.Timestamptz(3)
  /// Timestamp when the result was made visible to the learner.
  publishedAt  DateTime?  @map("published_at") @db.Timestamptz(3)
  /// True for the most recently accepted result for this revision.
  isCurrent    Boolean    @default(false) @map("is_current")
  /// Previous accepted assessment replaced by this one, if any.
  supersedesId String?    @map("supersedes_id") @db.Uuid

  result              AssessmentResult     @relation("AcceptedAssessment_resultId_resultKind_revisionId", fields: [resultId, resultKind, revisionId], references: [id, kind, revisionId], onDelete: Restrict, onUpdate: Restrict, map: "fk_accepted_assessment_result_id_result_kind_revision_id")
  supersedes          AcceptedAssessment?  @relation("AcceptedAssessment_supersedesId", fields: [supersedesId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accepted_assessment_supersedes_id")
  acceptedAssessments AcceptedAssessment[] @relation("AcceptedAssessment_supersedesId")
  appeals             Appeal[]             @relation("Appeal_acceptedId_revisionId")
  skillEvidences      SkillEvidence[]      @relation("SkillEvidence_acceptedId_resultId")

  @@unique([id, revisionId], map: "uq_accepted_assessment_id_revision_id")
  @@unique([id, resultId], map: "uq_accepted_assessment_id_result_id")
  @@unique([resultId, resultKind, revisionId], map: "uq_accepted_assessment_result_id_result_kind_revision_id")
  @@index([supersedesId], map: "ix_accepted_assessment_supersedes_id")
  @@index([revisionId, isCurrent], map: "ix_accepted_assessment_revision_id_is_current")
  @@map("ACCEPTED_ASSESSMENT")
}

/// A learner's formal objection to an AcceptedAssessment. If upheld, a new
/// ReviewCase is created and the accepted assessment may be replaced.
model Appeal {
  id           String       @id @default(uuid()) @db.Uuid
  acceptedId   String       @map("accepted_id") @db.Uuid
  revisionId   String       @map("revision_id") @db.Uuid
  requesterId  String       @map("requester_id") @db.Uuid
  /// ReviewCase created to handle this appeal; NULL until the appeal is escalated.
  reviewCaseId String?      @map("review_case_id") @db.Uuid
  status       AppealStatus @default(PENDING)
  /// Learner's written explanation of why they are appealing.
  reason       String       @db.Text
  /// Staff's written outcome after the appeal has been reviewed.
  resolution   String?      @db.Text
  requestedAt  DateTime     @default(now()) @map("requested_at") @db.Timestamptz(3)
  resolvedAt   DateTime?    @map("resolved_at") @db.Timestamptz(3)

  accepted   AcceptedAssessment @relation("Appeal_acceptedId_revisionId", fields: [acceptedId, revisionId], references: [id, revisionId], onDelete: Restrict, onUpdate: Restrict, map: "fk_appeal_accepted_id_revision_id")
  requester  User               @relation("Appeal_requesterId", fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_appeal_requester_id")
  reviewCase ReviewCase?        @relation("Appeal_reviewCaseId_revisionId", fields: [reviewCaseId, revisionId], references: [id, revisionId], onDelete: Restrict, onUpdate: Restrict, map: "fk_appeal_review_case_id_revision_id")

  @@index([acceptedId, revisionId], map: "ix_appeal_accepted_id_revision_id")
  @@index([requesterId], map: "ix_appeal_requester_id")
  @@index([reviewCaseId, revisionId], map: "ix_appeal_review_case_id_revision_id")
  @@map("APPEAL")
}

// ==========================================================================
// Skills, evidence, profile snapshots and recommendations
// ==========================================================================

/// A discrete, observable IELTS sub-skill (e.g. "Uses cohesive devices
/// effectively"). Skills are tagged to learning items and assessment items,
/// and are observed in assessment results to build learner profiles.
model Skill {
  id                   String            @id @default(uuid()) @db.Uuid
  /// Stable machine-readable identifier (e.g. "writing.coherence.cohesive_devices").
  code                 String            @unique(map: "uq_skill_code") @db.VarChar(80)
  name                 String            @db.VarChar(160)
  skillArea            SkillArea         @map("skill_area")
  /// Description of what a learner must do to demonstrate this skill.
  observableDefinition String            @map("observable_definition") @db.Text
  status               PublicationStatus @default(DRAFT)

  findings                              Finding[]           @relation("Finding_skillId")
  skillPrerequisites                    SkillPrerequisite[] @relation("SkillPrerequisite_skillId")
  skillPrerequisitesByPrerequisiteSkill SkillPrerequisite[] @relation("SkillPrerequisite_prerequisiteSkillId")
  learningItemSkills                    LearningItemSkill[] @relation("LearningItemSkill_skillId")
  itemSkills                            ItemSkill[]         @relation("ItemSkill_skillId")
  skillObservations                     SkillObservation[]  @relation("SkillObservation_skillId")
  learnerSkillStates                    LearnerSkillState[] @relation("LearnerSkillState_skillId")

  @@map("SKILL")
}

/// Prerequisite relationship between two skills. A learner is expected to
/// demonstrate prerequisiteSkill before tackling skill. minStrength and
/// minSupport define the minimum evidence thresholds required.
model SkillPrerequisite {
  skillId             String   @map("skill_id") @db.Uuid
  prerequisiteSkillId String   @map("prerequisite_skill_id") @db.Uuid
  /// Minimum mastery strength (0-1) the learner must achieve in the prerequisite.
  minStrength         Decimal? @map("min_strength") @db.Decimal(5, 4)
  /// Minimum evidence support level (0-1) required to unlock the dependent skill.
  minSupport          Decimal? @map("min_support") @db.Decimal(5, 4)

  skill             Skill @relation("SkillPrerequisite_skillId", fields: [skillId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_skill_prerequisite_skill_id")
  prerequisiteSkill Skill @relation("SkillPrerequisite_prerequisiteSkillId", fields: [prerequisiteSkillId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_skill_prerequisite_prerequisite_skill_id")

  @@id([skillId, prerequisiteSkillId])
  @@index([prerequisiteSkillId], map: "ix_skill_prerequisite_prerequisite_skill_id")
  @@map("SKILL_PREREQUISITE")
}

/// Tags a LearningItem with a Skill, indicating the purpose of the tag
/// (e.g. "TEACHES", "REINFORCES") and how heavily the item covers the skill.
model LearningItemSkill {
  learningItemId String  @map("learning_item_id") @db.Uuid
  skillId        String  @map("skill_id") @db.Uuid
  /// How this item relates to the skill (e.g. "TEACHES", "REINFORCES", "ASSESSES").
  purpose        String  @db.VarChar(24)
  /// Fractional weight (0-1) representing how much of the skill this item covers.
  coverageWeight Decimal @default(1) @map("coverage_weight") @db.Decimal(5, 4)

  learningItem LearningItem @relation("LearningItemSkill_learningItemId", fields: [learningItemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_learning_item_skill_learning_item_id")
  skill        Skill        @relation("LearningItemSkill_skillId", fields: [skillId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_learning_item_skill_skill_id")

  @@id([learningItemId, skillId])
  @@index([skillId], map: "ix_learning_item_skill_skill_id")
  @@map("LEARNING_ITEM_SKILL")
}

/// Tags an AssessmentItem with a Skill, indicating that a correct response
/// to the item provides evidence of the learner's skill level. The
/// observationWeight controls how much this item contributes to the skill
/// state relative to other items in the same result.
model ItemSkill {
  assessmentItemId  String  @map("assessment_item_id") @db.Uuid
  skillId           String  @map("skill_id") @db.Uuid
  /// Weight applied when aggregating skill observations from this item.
  observationWeight Decimal @default(1) @map("observation_weight") @db.Decimal(5, 4)

  assessmentItem AssessmentItem @relation("ItemSkill_assessmentItemId", fields: [assessmentItemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_item_skill_assessment_item_id")
  skill          Skill          @relation("ItemSkill_skillId", fields: [skillId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_item_skill_skill_id")

  @@id([assessmentItemId, skillId])
  @@index([skillId], map: "ix_item_skill_skill_id")
  @@map("ITEM_SKILL")
}

/// Records whether a specific skill was observed (and to what degree) within
/// a single AssessmentResult. One row per skill per result.
model SkillObservation {
  id        String             @id @default(uuid()) @db.Uuid
  resultId  String             @map("result_id") @db.Uuid
  skillId   String             @map("skill_id") @db.Uuid
  /// How well the skill was demonstrated in this result.
  outcome   ObservationOutcome
  /// Textual justification for the assigned outcome.
  rationale String             @db.Text

  result         AssessmentResult @relation("SkillObservation_resultId", fields: [resultId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_skill_observation_result_id")
  skill          Skill            @relation("SkillObservation_skillId", fields: [skillId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_skill_observation_skill_id")
  skillEvidences SkillEvidence[]  @relation("SkillEvidence_observationId_resultId")

  @@unique([resultId, skillId], map: "uq_skill_observation_result_id_skill_id")
  @@unique([id, resultId], map: "uq_skill_observation_id_result_id")
  @@index([skillId], map: "ix_skill_observation_skill_id")
  @@map("SKILL_OBSERVATION")
}

/// A confirmed piece of skill evidence derived from an AcceptedAssessment.
/// Bridges between the accepted result and the SkillObservation that supports
/// a specific learner profile build. The evidencePolicyVersion records which
/// evidence promotion policy was applied when the evidence was created.
model SkillEvidence {
  id                    String   @id @default(uuid()) @db.Uuid
  acceptedId            String   @map("accepted_id") @db.Uuid
  observationId         String   @map("observation_id") @db.Uuid
  /// Denormalised resultId for composite FK to SkillObservation.
  resultId              String   @map("result_id") @db.Uuid
  /// Identifies the version of the evidence promotion policy used.
  evidencePolicyVersion String   @map("evidence_policy_version") @db.VarChar(60)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  accepted             AcceptedAssessment    @relation("SkillEvidence_acceptedId_resultId", fields: [acceptedId, resultId], references: [id, resultId], onDelete: Restrict, onUpdate: Restrict, map: "fk_skill_evidence_accepted_id_result_id")
  observation          SkillObservation      @relation("SkillEvidence_observationId_resultId", fields: [observationId, resultId], references: [id, resultId], onDelete: Restrict, onUpdate: Restrict, map: "fk_skill_evidence_observation_id_result_id")
  profileContributions ProfileContribution[] @relation("ProfileContribution_evidenceId")

  @@unique([acceptedId, observationId], map: "uq_skill_evidence_accepted_id_observation_id")
  @@index([acceptedId, resultId], map: "ix_skill_evidence_accepted_id_result_id")
  @@index([observationId, resultId], map: "ix_skill_evidence_observation_id_result_id")
  @@map("SKILL_EVIDENCE")
}

/// An immutable, versioned projection and recommendation policy. Policies are
/// versioned so that old profile builds and recommendation runs can be
/// reproduced and explained using the policy in effect at the time.
model PolicyVersion {
  id          String @id @default(uuid()) @db.Uuid
  /// Machine-readable code shared across all versions of this policy.
  policyCode  String @map("policy_code") @db.VarChar(80)
  versionNo   Int    @default(1) @map("version_no")
  /// Indicates what the policy governs (e.g. "PROJECTION", "RECOMMENDATION").
  policyKind  String @map("policy_kind") @db.VarChar(30)
  /// Algorithm parameters and thresholds stored as JSON.
  configJson  Json   @map("config_json") @db.JsonB
  /// Git SHA or semantic version of the application code that introduced this policy.
  codeVersion String @map("code_version") @db.VarChar(120)

  learnerProfileVersions LearnerProfileVersion[] @relation("LearnerProfileVersion_projectionPolicyId")
  recommendationRuns     RecommendationRun[]     @relation("RecommendationRun_policyId")

  @@unique([policyCode, versionNo], map: "uq_policy_version_policy_code_version_no")
  @@map("POLICY_VERSION")
}

/// A versioned snapshot of a learner's skill profile at a point in time.
/// Created whenever the profile is rebuilt; older versions are retained for
/// history and to allow old recommendation runs to be explained.
model LearnerProfileVersion {
  id                 String   @id @default(uuid()) @db.Uuid
  learnerId          String   @map("learner_id") @db.Uuid
  versionNo          Int      @default(1) @map("version_no")
  /// The projection policy used when building this profile version.
  projectionPolicyId String   @map("projection_policy_id") @db.Uuid
  /// JSON snapshot of the learner's goals (target band, exam date, etc.) at build time.
  goalSnapshotJson   Json     @map("goal_snapshot_json") @db.JsonB
  /// Opaque cursor representing the latest SkillEvidence included in this build.
  evidenceWatermark  String   @map("evidence_watermark") @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  learner              User                  @relation("LearnerProfileVersion_learnerId", fields: [learnerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_learner_profile_version_learner_id")
  projectionPolicy     PolicyVersion         @relation("LearnerProfileVersion_projectionPolicyId", fields: [projectionPolicyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_learner_profile_version_projection_policy_id")
  learnerSkillStates   LearnerSkillState[]   @relation("LearnerSkillState_profileId")
  profileContributions ProfileContribution[] @relation("ProfileContribution_profileId")
  recommendationRuns   RecommendationRun[]   @relation("RecommendationRun_profileId_learnerId")

  @@unique([learnerId, versionNo], map: "uq_learner_profile_version_learner_id_version_no")
  @@unique([id, learnerId], map: "uq_learner_profile_version_id_learner_id")
  @@index([projectionPolicyId], map: "ix_learner_profile_version_projection_policy_id")
  @@index([learnerId, createdAt], map: "ix_learner_profile_version_learner_id_created_at")
  @@map("LEARNER_PROFILE_VERSION")
}

/// Per-skill state within a LearnerProfileVersion. strength = NULL when
/// observationStatus = UNKNOWN (no evidence yet). support represents the
/// sufficiency of evidence, NOT the AI model's confidence level.
model LearnerSkillState {
  profileId         String            @map("profile_id") @db.Uuid
  skillId           String            @map("skill_id") @db.Uuid
  /// Estimated mastery level (0-1); NULL when observationStatus = UNKNOWN.
  strength          Decimal?          @db.Decimal(5, 4)
  /// Evidence sufficiency score (0-1); 0 = no evidence, 1 = fully observed.
  support           Decimal           @default(0) @db.Decimal(5, 4)
  /// Number of individual evidence items included in this state.
  evidenceCount     Int               @default(0) @map("evidence_count")
  observationStatus ObservationStatus @map("observation_status")

  profile LearnerProfileVersion @relation("LearnerSkillState_profileId", fields: [profileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_learner_skill_state_profile_id")
  skill   Skill                 @relation("LearnerSkillState_skillId", fields: [skillId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_learner_skill_state_skill_id")

  @@id([profileId, skillId])
  @@index([skillId], map: "ix_learner_skill_state_skill_id")
  @@map("LEARNER_SKILL_STATE")
}

/// Records which SkillEvidence items contributed to a LearnerProfileVersion.
/// Each attempt-skill pair has at most one active contribution: the revision
/// with the highest revision_no that qualifies under the current decision.
/// Contributions are NOT accumulated across all revisions or sorted simply by
/// publication date.
model ProfileContribution {
  profileId       String  @map("profile_id") @db.Uuid
  evidenceId      String  @map("evidence_id") @db.Uuid
  /// Weight applied to this evidence item when computing the skill state.
  effectiveWeight Decimal @default(1) @map("effective_weight") @db.Decimal(7, 4)

  profile  LearnerProfileVersion @relation("ProfileContribution_profileId", fields: [profileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_profile_contribution_profile_id")
  evidence SkillEvidence         @relation("ProfileContribution_evidenceId", fields: [evidenceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_profile_contribution_evidence_id")

  @@id([profileId, evidenceId])
  @@index([evidenceId], map: "ix_profile_contribution_evidence_id")
  @@map("PROFILE_CONTRIBUTION")
}

/// Stores a snapshot of the candidate pool, filter criteria, metadata, and
/// the policy used during a recommendation run. Retained so that past
/// recommendation decisions can be audited and explained even after content
/// or policy changes.
model RecommendationRun {
  id                    String   @id @default(uuid()) @db.Uuid
  learnerId             String   @map("learner_id") @db.Uuid
  profileId             String   @map("profile_id") @db.Uuid
  policyId              String   @map("policy_id") @db.Uuid
  /// JSON snapshot of the learner's context at the time of the run (goals, skill gaps, etc.).
  contextSnapshotJson   Json     @map("context_snapshot_json") @db.JsonB
  /// JSON snapshot of all candidate learning items considered during the run.
  candidateSnapshotJson Json     @map("candidate_snapshot_json") @db.JsonB
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile             LearnerProfileVersion @relation("RecommendationRun_profileId_learnerId", fields: [profileId, learnerId], references: [id, learnerId], onDelete: Restrict, onUpdate: Restrict, map: "fk_recommendation_run_profile_id_learner_id")
  policy              PolicyVersion         @relation("RecommendationRun_policyId", fields: [policyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_recommendation_run_policy_id")
  recommendationItems RecommendationItem[]  @relation("RecommendationItem_runId")

  @@index([profileId, learnerId], map: "ix_recommendation_run_profile_id_learner_id")
  @@index([policyId], map: "ix_recommendation_run_policy_id")
  @@index([learnerId, createdAt], map: "ix_recommendation_run_learner_id_created_at")
  @@map("RECOMMENDATION_RUN")
}

/// One recommended learning item within a RecommendationRun (ranked 1-3).
/// If the target is a practice activity, both targetActivityVersionId and
/// targetAssignmentVersionId must be set; for lessons both must be NULL.
/// A snapshot of the target is stored so the recommendation can be explained
/// even if the underlying content changes later.
///
/// SQL CHECK: rank >= 1 AND rank <= 3
/// SQL CHECK: (target_activity_version_id IS NULL) = (target_assignment_version_id IS NULL)
model RecommendationItem {
  id                        String  @id @default(uuid()) @db.Uuid
  runId                     String  @map("run_id") @db.Uuid
  learningItemId            String  @map("learning_item_id") @db.Uuid
  /// NULL for lesson recommendations; required for practice activity recommendations.
  targetActivityVersionId   String? @map("target_activity_version_id") @db.Uuid
  /// NULL for lesson recommendations; required for practice activity recommendations.
  targetAssignmentVersionId String? @map("target_assignment_version_id") @db.Uuid
  /// Rank of this item within the run (1 = highest priority).
  rank                      Int
  /// Composite relevance score used to rank candidates.
  totalScore                Decimal @map("total_score") @db.Decimal(9, 5)
  /// Breakdown of the score by individual scoring components.
  scoreComponentsJson       Json    @map("score_components_json") @db.JsonB
  /// Machine-readable reason code (e.g. "SKILL_GAP", "PREREQUISITE_MET").
  reasonCode                String  @map("reason_code") @db.VarChar(60)
  /// Human-readable explanation shown to the learner.
  reasonText                String  @map("reason_text") @db.Text
  /// JSON snapshot of the target item's content at recommendation time.
  targetSnapshotJson        Json    @map("target_snapshot_json") @db.JsonB

  attempts                Attempt[]          @relation("Attempt_recommendationItemId_assignmentVersionId_activityVersionId")
  run                     RecommendationRun  @relation("RecommendationItem_runId", fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_recommendation_item_run_id")
  learningItem            LearningItem       @relation("RecommendationItem_learningItemId", fields: [learningItemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_recommendation_item_learning_item_id")
  targetActivityVersion   ActivityVersion?   @relation("RecommendationItem_targetActivityVersionId_learningItemId", fields: [targetActivityVersionId, learningItemId], references: [id, activityId], onDelete: Restrict, onUpdate: Restrict, map: "fk_recommendation_item_target_activity_version_i_68eec8d129")
  targetAssignmentVersion AssignmentVersion? @relation("RecommendationItem_targetAssignmentVersionId_targetActivityVersionId_learningItemId", fields: [targetAssignmentVersionId, targetActivityVersionId, learningItemId], references: [id, activityVersionId, activityId], onDelete: Restrict, onUpdate: Restrict, map: "fk_recommendation_item_target_assignment_version_3391d3702b")

  @@unique([runId, rank], map: "uq_recommendation_item_run_id_rank")
  @@unique([runId, learningItemId], map: "uq_recommendation_item_run_id_learning_item_id")
  @@unique([id, targetAssignmentVersionId, targetActivityVersionId], map: "uq_recommendation_item_id_target_assignment_vers_b59b36f30f")
  @@index([learningItemId], map: "ix_recommendation_item_learning_item_id")
  @@index([targetActivityVersionId, learningItemId], map: "ix_recommendation_item_target_activity_version_i_46f2ac183a")
  @@index([targetAssignmentVersionId, targetActivityVersionId, learningItemId], map: "ix_recommendation_item_target_assignment_version_c1eae1573f")
  @@map("RECOMMENDATION_ITEM")
}

// ==========================================================================
// Discussions, notifications and durable operations
// ==========================================================================

/// A discussion thread scoped to a course, optionally tied to a specific
/// learning item within that course.
model DiscussionThread {
  id            String   @id @default(uuid()) @db.Uuid
  courseId      String   @map("course_id") @db.Uuid
  /// Optional learning item that contextualises the discussion (e.g. a lesson or activity).
  contextItemId String?  @map("context_item_id") @db.Uuid
  creatorId     String   @map("creator_id") @db.Uuid
  title         String   @db.VarChar(240)
  /// Current state of the thread (e.g. "OPEN", "CLOSED", "LOCKED").
  status        String   @default("OPEN") @db.VarChar(24)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  course          Course           @relation("DiscussionThread_courseId", fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_discussion_thread_course_id")
  contextItem     LearningItem?    @relation("DiscussionThread_contextItemId", fields: [contextItemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_discussion_thread_context_item_id")
  creator         User             @relation("DiscussionThread_creatorId", fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_discussion_thread_creator_id")
  discussionPosts DiscussionPost[] @relation("DiscussionPost_threadId")

  @@index([courseId], map: "ix_discussion_thread_course_id")
  @@index([contextItemId], map: "ix_discussion_thread_context_item_id")
  @@index([creatorId], map: "ix_discussion_thread_creator_id")
  @@map("DISCUSSION_THREAD")
}

/// A post (top-level or reply) within a DiscussionThread. A reply must belong
/// to the same thread as its parent; circular references are prohibited.
model DiscussionPost {
  id           String    @id @default(uuid()) @db.Uuid
  threadId     String    @map("thread_id") @db.Uuid
  authorId     String    @map("author_id") @db.Uuid
  /// Parent post for replies; NULL for top-level posts.
  parentPostId String?   @map("parent_post_id") @db.Uuid
  /// Full text content of the post.
  body         String    @db.Text
  /// Visibility state (e.g. "VISIBLE", "HIDDEN", "DELETED").
  status       String    @default("VISIBLE") @db.VarChar(24)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Set when the author edits the post after initial publication.
  editedAt     DateTime? @map("edited_at") @db.Timestamptz(3)

  thread            DiscussionThread   @relation("DiscussionPost_threadId", fields: [threadId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_discussion_post_thread_id")
  author            User               @relation("DiscussionPost_authorId", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_discussion_post_author_id")
  parentPost        DiscussionPost?    @relation("DiscussionPost_parentPostId", fields: [parentPostId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_discussion_post_parent_post_id")
  discussionPosts   DiscussionPost[]   @relation("DiscussionPost_parentPostId")
  moderationReports ModerationReport[] @relation("ModerationReport_postId")

  @@index([threadId], map: "ix_discussion_post_thread_id")
  @@index([authorId], map: "ix_discussion_post_author_id")
  @@index([parentPostId], map: "ix_discussion_post_parent_post_id")
  @@map("DISCUSSION_POST")
}

/// An in-app notification delivered to a single recipient. The navigationPath
/// provides a deep link for the UI but does not grant any permissions.
model Notification {
  id                  String    @id @default(uuid()) @db.Uuid
  recipientId         String    @map("recipient_id") @db.Uuid
  /// Category of notification (e.g. "RESULT_PUBLISHED", "APPEAL_RESOLVED").
  notificationType    String    @map("notification_type") @db.VarChar(60)
  title               String    @db.VarChar(240)
  body                String    @db.Text
  /// Optional deep-link path for routing the user to the relevant screen.
  navigationPath      String?   @map("navigation_path") @db.Text
  /// JSON snapshot of contextual data needed to render the notification body.
  contextSnapshotJson Json?     @map("context_snapshot_json") @db.JsonB
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Set when the recipient opens/reads the notification; NULL = unread.
  readAt              DateTime? @map("read_at") @db.Timestamptz(3)

  recipient User @relation("Notification_recipientId", fields: [recipientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notification_recipient_id")

  @@index([recipientId], map: "ix_notification_recipient_id")
  @@index([recipientId, readAt, createdAt], map: "ix_notification_recipient_id_read_at_created_at")
  @@map("NOTIFICATION")
}

/// A content moderation report filed against exactly one target: a course,
/// a learning item, or a discussion post.
///
/// SQL CHECK: exactly one of (course_id, learning_item_id, post_id) must be non-NULL.
model ModerationReport {
  id             String           @id @default(uuid()) @db.Uuid
  reporterId     String           @map("reporter_id") @db.Uuid
  /// Staff member who resolved or dismissed the report; NULL while pending.
  resolverId     String?          @map("resolver_id") @db.Uuid
  /// Targeted course; exactly one of the three target fields must be non-NULL.
  courseId       String?          @map("course_id") @db.Uuid
  /// Targeted learning item; exactly one of the three target fields must be non-NULL.
  learningItemId String?          @map("learning_item_id") @db.Uuid
  /// Targeted discussion post; exactly one of the three target fields must be non-NULL.
  postId         String?          @map("post_id") @db.Uuid
  /// Reporter's description of the policy violation.
  reason         String           @db.Text
  status         ModerationStatus @default(PENDING)
  /// Staff's description of the action taken when the report was resolved.
  resolution     String?          @db.Text
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz(3)

  reporter     User            @relation("ModerationReport_reporterId", fields: [reporterId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_moderation_report_reporter_id")
  resolver     User?           @relation("ModerationReport_resolverId", fields: [resolverId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_moderation_report_resolver_id")
  course       Course?         @relation("ModerationReport_courseId", fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_moderation_report_course_id")
  learningItem LearningItem?   @relation("ModerationReport_learningItemId", fields: [learningItemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_moderation_report_learning_item_id")
  post         DiscussionPost? @relation("ModerationReport_postId", fields: [postId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_moderation_report_post_id")

  @@index([reporterId], map: "ix_moderation_report_reporter_id")
  @@index([resolverId], map: "ix_moderation_report_resolver_id")
  @@index([courseId], map: "ix_moderation_report_course_id")
  @@index([learningItemId], map: "ix_moderation_report_learning_item_id")
  @@index([postId], map: "ix_moderation_report_post_id")
  @@map("MODERATION_REPORT")
}

/// A durable domain event stored using the transactional outbox pattern.
/// Written in the same transaction as the business operation; dispatched to
/// the message bus by a background relay. The aggregate locator fields
/// are historical routing data, NOT foreign keys to live business records.
model OutboxEvent {
  id               String       @id @default(uuid()) @db.Uuid
  /// Type of domain event (e.g. "AssessmentResultPublished", "EnrollmentCreated").
  eventType        String       @map("event_type") @db.VarChar(80)
  /// The aggregate type that raised the event (e.g. "Attempt", "ReviewCase").
  aggregateType    String       @map("aggregate_type") @db.VarChar(80)
  /// String representation of the aggregate's primary key.
  aggregateId      String       @map("aggregate_id") @db.Text
  /// Optimistic-lock version of the aggregate when the event was emitted; NULL if unused.
  aggregateVersion Int?         @map("aggregate_version")
  /// Full event payload serialised as JSON.
  payloadJson      Json         @map("payload_json") @db.JsonB
  status           OutboxStatus @default(PENDING)
  /// Number of dispatch attempts made so far.
  attempts         Int          @default(0)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Timestamp of the most recent successful dispatch.
  dispatchedAt     DateTime?    @map("dispatched_at") @db.Timestamptz(3)

  @@index([status, createdAt], map: "ix_outbox_event_status_created_at")
  @@map("OUTBOX_EVENT")
}

/// Append-only audit trail of significant actions performed by actors in the
/// system. Entity locator fields (entityType, entityKey) are audit snapshots;
/// they do NOT cascade when the referenced business object is deleted.
model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  /// The user who performed the action; NULL for system-initiated events.
  actorId    String?  @map("actor_id") @db.Uuid
  /// Verb describing the action taken (e.g. "ENROLL", "SUBMIT", "APPROVE").
  action     String   @db.VarChar(100)
  /// Type name of the entity that was acted on (e.g. "Enrollment", "ReviewCase").
  entityType String   @map("entity_type") @db.VarChar(100)
  /// String key that identifies the specific entity instance (e.g. UUID).
  entityKey  String   @map("entity_key") @db.Text
  /// JSON snapshot of the entity's state before the action; NULL for creations.
  beforeJson Json?    @map("before_json") @db.JsonB
  /// JSON snapshot of the entity's state after the action; NULL for deletions.
  afterJson  Json?    @map("after_json") @db.JsonB
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  actor User? @relation("AuditEvent_actorId", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_audit_event_actor_id")

  @@index([actorId], map: "ix_audit_event_actor_id")
  @@map("AUDIT_EVENT")
}

// ==========================================================================
// Optional RAG extension: vector requires pgvector before table creation
// ==========================================================================

/// EXTENSION: A knowledge document with access-control scoping to a course.
/// Used as the source corpus for Retrieval-Augmented Generation (RAG) when
/// generating feedback explanations.
model KnowledgeDocument {
  id           String            @id @default(uuid()) @db.Uuid
  courseId     String            @map("course_id") @db.Uuid
  /// Optional learning item that this document was derived from.
  sourceItemId String?           @map("source_item_id") @db.Uuid
  ownerId      String            @map("owner_id") @db.Uuid
  title        String            @db.VarChar(240)
  status       PublicationStatus @default(DRAFT)
  /// Access level (e.g. "PUBLIC", "ENROLLED", "INSTRUCTOR_ONLY").
  visibility   String            @db.VarChar(30)

  course                    Course                     @relation("KnowledgeDocument_courseId", fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_knowledge_document_course_id")
  sourceItem                LearningItem?              @relation("KnowledgeDocument_sourceItemId", fields: [sourceItemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_knowledge_document_source_item_id")
  owner                     User                       @relation("KnowledgeDocument_ownerId", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_knowledge_document_owner_id")
  knowledgeDocumentVersions KnowledgeDocumentVersion[] @relation("KnowledgeDocumentVersion_documentId")

  @@index([courseId], map: "ix_knowledge_document_course_id")
  @@index([sourceItemId], map: "ix_knowledge_document_source_item_id")
  @@index([ownerId], map: "ix_knowledge_document_owner_id")
  @@map("KNOWLEDGE_DOCUMENT")
}

/// EXTENSION: An immutable versioned snapshot of a KnowledgeDocument's content.
/// Creating a new version preserves the history of the document while allowing
/// the vector index to be rebuilt for the updated content.
model KnowledgeDocumentVersion {
  id           String    @id @default(uuid()) @db.Uuid
  documentId   String    @map("document_id") @db.Uuid
  versionNo    Int       @default(1) @map("version_no")
  /// Optional source file; NULL if content was entered directly as text.
  fileAssetId  String?   @map("file_asset_id") @db.Uuid
  /// Full text of the document captured at the time this version was created.
  textSnapshot String    @map("text_snapshot") @db.Text
  /// SHA-256 hash of textSnapshot for deduplication and integrity checks.
  contentHash  String    @map("content_hash") @db.VarChar(128)
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(3)

  document        KnowledgeDocument @relation("KnowledgeDocumentVersion_documentId", fields: [documentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_knowledge_document_version_document_id")
  fileAsset       FileAsset?        @relation("KnowledgeDocumentVersion_fileAssetId", fields: [fileAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_knowledge_document_version_file_asset_id")
  knowledgeChunks KnowledgeChunk[]  @relation("KnowledgeChunk_documentVersionId")

  @@unique([documentId, versionNo], map: "uq_knowledge_document_version_document_id_version_no")
  @@index([fileAssetId], map: "ix_knowledge_document_version_file_asset_id")
  @@map("KNOWLEDGE_DOCUMENT_VERSION")
}

/// EXTENSION: A text chunk from a KnowledgeDocumentVersion, optionally
/// equipped with a pgvector embedding. The embedding dimension depends on the
/// model used and requires a separate pgvector migration before deployment.
model KnowledgeChunk {
  id                  String                 @id @default(uuid()) @db.Uuid
  documentVersionId   String                 @map("document_version_id") @db.Uuid
  /// 1-based sequence number of this chunk within the document version.
  chunkNo             Int                    @map("chunk_no")
  /// The text content of this chunk.
  text                String                 @db.Text
  /// pgvector embedding; requires pgvector extension and a dedicated migration.
  embedding           Unsupported("vector")?
  /// Name/version of the embedding model used to produce the vector.
  embeddingModel      String?                @map("embedding_model") @db.VarChar(120)
  /// JSON configuration of the embedding model (e.g. dimensions, normalisation).
  embeddingConfigJson Json?                  @map("embedding_config_json") @db.JsonB

  documentVersion      KnowledgeDocumentVersion @relation("KnowledgeChunk_documentVersionId", fields: [documentVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_knowledge_chunk_document_version_id")
  explanationCitations ExplanationCitation[]    @relation("ExplanationCitation_chunkId")

  @@unique([documentVersionId, chunkNo], map: "uq_knowledge_chunk_document_version_id_chunk_no")
  @@map("KNOWLEDGE_CHUNK")
}

/// EXTENSION: A sourced AI-generated explanation provided to a learner in
/// response to a question about their feedback. This is NOT an assessment
/// result or accepted evidence; it is purely informational.
model FeedbackExplanation {
  id                    String   @id @default(uuid()) @db.Uuid
  learnerId             String   @map("learner_id") @db.Uuid
  /// The submission revision the learner is asking about; NULL for general questions.
  revisionId            String?  @map("revision_id") @db.Uuid
  /// The specific finding the learner wants explained; NULL for general questions.
  findingId             String?  @map("finding_id") @db.Uuid
  promptVersionId       String   @map("prompt_version_id") @db.Uuid
  /// The learner's question as entered.
  question              String   @db.Text
  /// The AI-generated answer returned to the learner.
  answer                String   @db.Text
  /// AI provider used to generate the explanation (e.g. "openai", "google").
  provider              String   @db.VarChar(60)
  modelId               String   @map("model_id") @db.VarChar(120)
  /// JSON snapshot of the retrieved knowledge chunks used to ground the answer.
  retrievalSnapshotJson Json     @map("retrieval_snapshot_json") @db.JsonB
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  learner              User                  @relation("FeedbackExplanation_learnerId", fields: [learnerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_feedback_explanation_learner_id")
  revision             SubmissionRevision?   @relation("FeedbackExplanation_revisionId", fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_feedback_explanation_revision_id")
  finding              Finding?              @relation("FeedbackExplanation_findingId", fields: [findingId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_feedback_explanation_finding_id")
  promptVersion        PromptVersion         @relation("FeedbackExplanation_promptVersionId", fields: [promptVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_feedback_explanation_prompt_version_id")
  explanationCitations ExplanationCitation[] @relation("ExplanationCitation_explanationId")

  @@index([learnerId], map: "ix_feedback_explanation_learner_id")
  @@index([revisionId], map: "ix_feedback_explanation_revision_id")
  @@index([findingId], map: "ix_feedback_explanation_finding_id")
  @@index([promptVersionId], map: "ix_feedback_explanation_prompt_version_id")
  @@map("FEEDBACK_EXPLANATION")
}

/// EXTENSION: Links a FeedbackExplanation to the specific KnowledgeChunk(s)
/// that were retrieved and cited when generating the answer. The chunk belongs
/// to an immutable document version, guaranteeing citation stability.
model ExplanationCitation {
  explanationId String @map("explanation_id") @db.Uuid
  /// 1-based citation number within the explanation.
  citationNo    Int    @map("citation_no")
  chunkId       String @map("chunk_id") @db.Uuid
  /// Verbatim quote from the chunk that supports the cited claim.
  exactQuote    String @map("exact_quote") @db.Text

  explanation FeedbackExplanation @relation("ExplanationCitation_explanationId", fields: [explanationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_explanation_citation_explanation_id")
  chunk       KnowledgeChunk      @relation("ExplanationCitation_chunkId", fields: [chunkId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_explanation_citation_chunk_id")

  @@id([explanationId, citationNo])
  @@index([chunkId], map: "ix_explanation_citation_chunk_id")
  @@map("EXPLANATION_CITATION")
}
